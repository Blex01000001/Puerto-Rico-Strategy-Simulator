@implements IDisposable
@inject AppState State
@inject IConfiguration Config
@inject PageMemory Memory

<div class="panel">
    <div class="row picker">
        <label>@L.T("fp.label")
            <select @bind="selected">
                <option value="">(@(files.Count == 0 ? L.T("fp.empty") : L.T("fp.choose")))</option>
                @foreach (var f in files)
                {
                    <option value="@f">@ResultFiles.Label(dir, f) (@(FileSize(f)))</option>
                }
            </select>
        </label>
        <button @onclick="LoadSelected" disabled="@(string.IsNullOrEmpty(selected) || State.Loading)">@L.T("fp.load")</button>
        <button class="secondary" @onclick="Refresh">@L.T("sim.refresh")</button>
        @ChildContent
    </div>
    <p class="note">@L.T("fp.note", AppState.DisplayPath(dir))</p>
    @if (State.Loading) { <p>@L.T("fp.loading")</p> }
    @if (State.Error != null) { <div class="error">@State.Error</div> }
</div>

@code {
    /// <summary>Extra controls shown right of the refresh button.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string dir = "";
    private List<string> files = new();
    private string selected = "";

    protected override void OnInitialized()
    {
        State.Changed += OnChanged;
        dir = AppState.ResultsDirectory(Config);
        Refresh();
        selected = Memory.Get<string>("filepicker") ?? "";
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private void Refresh() =>
        files = ResultFiles.List(dir);

    private static string FileSize(string f)
    {
        long b = new FileInfo(f).Length;
        return b >= 1 << 20 ? $"{b / 1048576.0:0.#} MB" : $"{Math.Max(1, b / 1024)} KB";
    }

    private Task LoadSelected() => State.LoadPathAsync(selected);

    public void Dispose()
    {
        State.Changed -= OnChanged;
        Memory.Set("filepicker", selected);
    }
}
