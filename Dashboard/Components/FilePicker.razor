@implements IDisposable
@inject AppState State
@inject IConfiguration Config

<div class="panel">
    <div class="row">
        <label>結果檔
            <select @bind="selected">
                <option value="">（@(files.Count == 0 ? "資料夾內沒有 .json" : "選擇檔案")）</option>
                @foreach (var f in files)
                {
                    <option value="@f">@Path.GetFileName(f) （@(FileSize(f))）</option>
                }
            </select>
        </label>
        <button @onclick="LoadSelected" disabled="@(string.IsNullOrEmpty(selected) || State.Loading)">載入</button>
        <button class="secondary" @onclick="Refresh">重新整理</button>
        @ChildContent
    </div>
    <p class="note">掃描資料夾：@AppState.DisplayPath(dir)（可在 appsettings.json 的 Dashboard:ResultsDirectory 改）。大檔案（10 萬局約 40 MB）載入需要幾秒。</p>
    @if (State.Loading) { <p>載入並計算中…</p> }
    @if (State.Error != null) { <div class="error">@State.Error</div> }
</div>

@code {
    /// <summary>Extra controls shown right of the refresh button.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string dir = "";
    private List<string> files = new();
    private string selected = "";

    protected override void OnInitialized()
    {
        State.Changed += OnChanged;
        dir = AppState.ResultsDirectory(Config);
        Refresh();
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private void Refresh() =>
        files = Directory.Exists(dir)
            ? Directory.GetFiles(dir, "*.json").Where(f => !f.EndsWith(".tmp")).OrderBy(f => f, StringComparer.OrdinalIgnoreCase).ToList()
            : new List<string>();

    private static string FileSize(string f)
    {
        long b = new FileInfo(f).Length;
        return b >= 1 << 20 ? $"{b / 1048576.0:0.#} MB" : $"{Math.Max(1, b / 1024)} KB";
    }

    private Task LoadSelected() => State.LoadPathAsync(selected);

    public void Dispose() => State.Changed -= OnChanged;
}
