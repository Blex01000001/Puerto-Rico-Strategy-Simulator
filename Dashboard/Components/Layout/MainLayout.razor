@inherits LayoutComponentBase

<div class="shell @(collapsed ? "collapsed" : "")">
    <nav class="sidebar" aria-label="主選單">
        <div class="navtop">
            <a class="brandlink" href="" title="回到 HOME">
                <img class="brandicon" src="favicon.svg" alt="" />
                <span class="brand">波多黎各<br />策略模擬器</span>
            </a>
            <button class="navtoggle" @onclick="() => collapsed = !collapsed" title="@(collapsed ? "展開選單" : "收折選單")" aria-label="@(collapsed ? "展開選單" : "收折選單")" aria-expanded="@(!collapsed)">
                <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><rect x="2.5" y="3.5" width="15" height="13" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.6" /><line x1="7.5" y1="3.5" x2="7.5" y2="16.5" stroke="currentColor" stroke-width="1.6" /><path d="@(collapsed ? "M11 7.5l2.5 2.5-2.5 2.5" : "M13.5 7.5L11 10l2.5 2.5")" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </button>
        </div>

        <NavLink href="" Match="NavLinkMatch.All" ActiveClass="active" title="HOME"><span class="ni">🏠</span><span class="nl">HOME</span></NavLink>

        <div class="navsec">執行</div>
        <NavLink href="simulate" ActiveClass="active" title="策略模擬"><span class="ni">🎲</span><span class="nl">策略模擬</span></NavLink>

        <div class="navsec">分析</div>
        <NavLink href="results" ActiveClass="active" title="結果總覽"><span class="ni">📊</span><span class="nl">結果總覽</span></NavLink>
        <NavLink href="overview" ActiveClass="active" title="對戰總覽"><span class="ni">🏆</span><span class="nl">對戰總覽</span></NavLink>
        <NavLink href="compare" ActiveClass="active" title="結果並排比較"><span class="ni">⚖️</span><span class="nl">結果並排比較</span></NavLink>
        <NavLink href="replay" ActiveClass="active" title="模擬重播"><span class="ni">🎬</span><span class="nl">模擬重播</span></NavLink>

        <div class="navsec">進階</div>
        <NavLink href="sweep" ActiveClass="active" title="參數掃描"><span class="ni">🎛️</span><span class="nl">參數掃描</span></NavLink>
        <NavLink href="config" ActiveClass="active" title="設定檔"><span class="ni">📝</span><span class="nl">設定檔</span></NavLink>

        <div class="navsec">機器學習</div>
        @* Separate Python app (ml/ui.py); it must be started on its own: ml/start-ui.cmd (Windows) or ml/start-ui.sh *@
        <a href="http://localhost:8501" target="_blank" rel="noopener" title="ML UI：訓練與瀏覽局面價值模型（新分頁；要先另外啟動 ml/start-ui.cmd 或 ml/start-ui.sh）"><span class="ni">🌱</span><span class="nl">ML UI ↗</span></a>
    </nav>
    <main>
        @Body
    </main>
</div>

<div id="blazor-error-ui">
    發生未處理的錯誤。
    <a href="" class="reload">重新載入</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private bool collapsed;
}
