@inherits LayoutComponentBase
@inject NavigationManager Nav

<div class="shell @(collapsed ? "collapsed" : "")">
    <nav class="sidebar" aria-label="@L.T("nav.aria")">
        <div class="navtop">
            <a class="brandlink" href="" title="@L.T("nav.home_title")">
                <img class="brandicon" src="favicon.svg" alt="" />
                <span class="brand">@((MarkupString)L.T("app.brand"))</span>
            </a>
            <button class="navtoggle" @onclick="() => collapsed = !collapsed" title="@(collapsed ? L.T("nav.expand") : L.T("nav.collapse"))" aria-label="@(collapsed ? L.T("nav.expand") : L.T("nav.collapse"))" aria-expanded="@(!collapsed)">
                <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><rect x="2.5" y="3.5" width="15" height="13" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.6" /><line x1="7.5" y1="3.5" x2="7.5" y2="16.5" stroke="currentColor" stroke-width="1.6" /><path d="@(collapsed ? "M11 7.5l2.5 2.5-2.5 2.5" : "M13.5 7.5L11 10l2.5 2.5")" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </button>
        </div>

        <NavLink href="" Match="NavLinkMatch.All" ActiveClass="active" title="HOME"><span class="ni">🏠</span><span class="nl">HOME</span></NavLink>

        <div class="navsec">@L.T("nav.sec.run")</div>
        <NavLink href="simulate" ActiveClass="active" title="@L.T("nav.simulate")"><span class="ni">🎲</span><span class="nl">@L.T("nav.simulate")</span></NavLink>

        <div class="navsec">@L.T("nav.sec.analyse")</div>
        <NavLink href="results" ActiveClass="active" title="@L.T("nav.results")"><span class="ni">📊</span><span class="nl">@L.T("nav.results")</span></NavLink>
        <NavLink href="overview" ActiveClass="active" title="@L.T("nav.overview")"><span class="ni">🏆</span><span class="nl">@L.T("nav.overview")</span></NavLink>
        <NavLink href="compare" ActiveClass="active" title="@L.T("nav.compare")"><span class="ni">⚖️</span><span class="nl">@L.T("nav.compare")</span></NavLink>
        <NavLink href="replay" ActiveClass="active" title="@L.T("nav.replay")"><span class="ni">🎬</span><span class="nl">@L.T("nav.replay")</span></NavLink>

        <div class="navsec">@L.T("nav.sec.advanced")</div>
        <NavLink href="sweep" ActiveClass="active" title="@L.T("nav.sweep")"><span class="ni">🎛️</span><span class="nl">@L.T("nav.sweep")</span></NavLink>
        <NavLink href="config" ActiveClass="active" title="@L.T("nav.config")"><span class="ni">📝</span><span class="nl">@L.T("nav.config")</span></NavLink>
        <NavLink href="versions" ActiveClass="active" title="@L.T("nav.versions")"><span class="ni">🏷️</span><span class="nl">@L.T("nav.versions")</span></NavLink>

        <div class="navsec">@L.T("nav.sec.ml")</div>
        @* Separate Python app (ml/ui.py on localhost:8501): status, link, and a button that runs ml/start-ui when it is down *@
        <MlUiNav />

        <button type="button" class="navbtn langbtn" @onclick="SwitchLanguage" title="@L.T("lang.switch")"><span class="ni">🌐</span><span class="nl">@L.T("lang.switch")</span></button>
    </nav>
    <main>
        @Body
    </main>
</div>

<div id="blazor-error-ui">
    @L.T("nav.error")
    <a href="" class="reload">@L.T("nav.reload")</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private bool collapsed;

    /// <summary>A full page load through /lang/{code}: the server sets the cookie and sends the browser back to this page.</summary>
    private void SwitchLanguage() =>
        Nav.NavigateTo($"lang/{L.Other}?returnUrl={Uri.EscapeDataString("/" + Nav.ToBaseRelativePath(Nav.Uri))}", forceLoad: true);
}
