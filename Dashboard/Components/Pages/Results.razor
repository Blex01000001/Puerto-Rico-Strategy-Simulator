@page "/results"
@implements IDisposable
@inject AppState State
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>@L.T("res.page_title")</PageTitle>
<h1>@L.T("nav.results")</h1>
<p class="note">@((MarkupString)L.T("res.intro"))</p>

<FilePicker>
    @if (State.Result != null && State.Sweep == null)
    {
        <button @onclick="SimulateAgain" title="@L.T("res.again_title")">@L.T("res.again")</button>
    }
</FilePicker>

@if (State.Sweep != null)
{
    <div class="ok">@L.T("res.sweep_loaded")</div>
}
else if (State.Result != null && State.Analysis != null)
{
    var r = State.Result;
    var a = State.Analysis;
    var strategies = a.Strategies;
    string summaryText = ResultSummary.ToMarkdown(r, a, L.T);
    string Pct(double v) => v.ToString("P1");
    string Color(int i) => Palette.Color(strategies[i].Strategy, i);
    string Name(int i) => Palette.Label(strategies[i].SeatId, strategies[i].Strategy);

    <div class="kpis centre">
        <div class="kpi"><div class="v">@a.GamesCompleted.ToString("N0")</div><div class="l">@L.T("res.kpi.games", r.Status)</div></div>
        <div class="kpi"><div class="v">@r.Config.Players</div><div class="l">@L.T("res.kpi.players")</div></div>
        <div class="kpi"><div class="v">@r.Config.Seed</div><div class="l">@L.T("res.kpi.seed")</div></div>
        <div class="kpi"><div class="v">@Palette.SeatOrderLabel(r.Config.SeatOrder, L)</div><div class="l">@L.T("res.kpi.order")</div></div>
        @if (a.HasGameRecords)
        {
            <div class="kpi"><div class="v">@a.AvgRounds.ToString("0.0")</div><div class="l">@L.T("res.kpi.rounds")</div></div>
            <div class="kpi"><div class="v">@a.AvgDecisions.ToString("0")</div><div class="l">@L.T("res.kpi.decisions")</div></div>
        }
        <div class="kpi"><div class="v">@r.EngineVersion</div><div class="l">@L.T("res.kpi.engine", r.RulesVersion)</div></div>
    </div>
    <div class="ai-summary">
        <button class="secondary" @onclick="() => CopySummary(summaryText)">@(copied ? L.T("res.copied") : L.T("res.copy"))</button>
        <span class="note">@L.T("res.copy_note")</span>
    </div>
    @if (r.Status != "completed")
    {
        <div class="error">@L.T("res.status_warn", r.Status, a.GamesCompleted, r.GamesRequested)</div>
    }

    <div class="grid2">
    <div>
    <h2>@L.T("res.h.winrate")</h2>
    <p class="note">@L.T("res.winrate_note", (1.0 / r.Config.Players).ToString("P1"))</p>
    <figure class="chartbox">
        <BarChart Title="@L.T("res.h.winrate")" Width="520" LabelWidth="170" Format="@(v => v.ToString("P1"))"
                  Items="@(strategies.Select((s, i) => (s, i)).OrderByDescending(x => x.s.WinShare).Select(x => new BarChart.BarItem(Name(x.i), x.s.WinShare, x.s.WinShareCi95, Color(x.i),
                       L.T("res.winrate_tip", Name(x.i), Pct(x.s.WinShare), Pct(x.s.WinShareCi95), x.s.Games.ToString("N0")))).ToList())" />
    </figure>
    </div>

    <div>
    <h2>@L.T("res.h.score")</h2>
    <p class="note">@L.T("res.score_note")</p>
    <figure class="chartbox">
        <BarChart Title="@L.T("res.h.score")" Width="520" LabelWidth="170" Format="@(v => v.ToString("0.0"))"
                  Items="@(strategies.Select((s, i) => (s, i)).OrderByDescending(x => x.s.AvgScore).Select(x => new BarChart.BarItem(Name(x.i), x.s.AvgScore, x.s.StdScore, Color(x.i),
                       L.T("res.score_tip", Name(x.i), x.s.AvgScore.ToString("0.0"), x.s.StdScore.ToString("0.0")))).ToList())" />
    </figure>
    </div>
    </div>

    <div class="grid2">
        <div>
            <h2>@L.T("res.h.parts")</h2>
            <p class="note">@L.T("res.parts_note")</p>
            <figure class="chartbox">
                <StackedBars Title="@L.T("res.h.parts")" Width="440" LabelWidth="150" Segments="@(new[] { L.T("res.seg.chips"), L.T("res.seg.buildings"), L.T("res.seg.bonus") })"
                             Rows="@(strategies.Select((s, i) => new StackedBars.StackRow(Name(i), new[] { s.AvgChips, s.AvgBuildingPoints, s.AvgBonusPoints })).OrderByDescending(r => r.Values.Sum()).ToList())" />
            </figure>
        </div>
        <div>
            <h2>@L.T("res.h.seat")</h2>
            <p class="note">@L.T("res.seat_note")</p>
            <figure class="chartbox">
                <BarChart Title="@L.T("res.h.seat")" Width="440" LabelWidth="70" Format="@(v => v.ToString("P1"))"
                          Items="@(a.TableSeats.Select(t => new BarChart.BarItem(L.T("sim.seat_n", t.Seat + 1), t.WinShare, 0, "var(--accent)",
                               L.T("res.seat_tip", t.Seat + 1, Pct(t.WinShare), t.AvgScore.ToString("0.0")))).ToList())" />
            </figure>
        </div>
    </div>

    @if (a.HasGameRecords && a.HasBuildingRecords)
    {
        <h2>@L.T("res.h.behaviour")</h2>
        <p class="note">@L.T("res.behaviour_note")</p>
        <div class="tablewrap">
            <table class="data">
                <thead>
                    <tr><th>@L.T("res.th.strategy")</th><th>@L.T("res.th.harbor_rate")</th><th>@L.T("res.th.harbor_round")</th><th>@L.T("res.th.buildings")</th><th>@L.T("res.th.large")</th><th>@L.T("res.th.shipments")</th>
                        <th>@L.T("res.th.corn")</th><th>@L.T("res.th.indigo")</th><th>@L.T("res.th.sugar")</th><th>@L.T("res.th.tobacco")</th><th>@L.T("res.th.coffee")</th><th>@L.T("res.th.quarry")</th><th>@L.T("res.th.coins")</th></tr>
                </thead>
                <tbody>
                @for (int i = 0; i < strategies.Count; i++)
                {
                    var s = strategies[i];
                    <tr>
                        <td><span class="swatch" style="background:@Color(i)"></span>@Name(i)</td>
                        <td>@Pct(s.HarborShare)</td><td>@(s.HarborShare > 0 ? s.AvgHarborRound.ToString("0.0") : "—")</td>
                        <td>@s.AvgBuildings.ToString("0.0")</td><td>@s.AvgLargeBuildings.ToString("0.00")</td><td>@s.AvgShipments.ToString("0.0")</td>
                        @foreach (var t in s.AvgTiles) { <td>@t.ToString("0.0")</td> }
                        <td>@s.AvgCoins.ToString("0.0")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <h2>@L.T("res.h.buildings")</h2>
        <p class="note">@L.T("res.buildings_note", (1.0 / r.Config.Players).ToString("P1"))</p>
        <figure class="chartbox" style="max-width:560px">
            <BarChart Title="@L.T("res.buildings_chart")" Width="520" LabelWidth="150" Format="@(v => v.ToString("P1"))"
                      Items="@(a.Buildings.Where(b => b.OwnerPlayers >= 300 && b.WinShareOwned > 0.25).OrderByDescending(b => b.WinShareOwned).Take(15)
                           .Select(b => new BarChart.BarItem(b.Name, b.WinShareOwned, PuertoRico.Engine.Simulation.ResultAnalysis.Ci(b.WinShareOwned, b.OwnerPlayers), "var(--accent)",
                               L.T("res.buildings_tip", b.Name, b.OwnerPlayers.ToString("N0"), Pct(b.WinShareOwned), Pct(b.WinShareNotOwned), b.AvgBuiltRound.ToString("0.0")))).ToList())" />
        </figure>
        <details>
            <summary>@L.T("res.all_buildings")</summary>
            <div class="tablewrap">
                <table class="data heat">
                    <thead>
                        <tr><th>@L.T("res.th.building")</th>@for (int j = 0; j < strategies.Count; j++) { <th>@Name(j)</th> }<th>@L.T("res.th.owners")</th><th>@L.T("res.th.avg_round")</th><th>@L.T("res.th.win_owned")</th><th>@L.T("res.th.win_not")</th></tr>
                    </thead>
                    <tbody>
                    @foreach (var b in a.Buildings)
                    {
                        <tr>
                            <td>@b.Name</td>
                            @foreach (var share in b.OwnedShare) { <td class="cell" style="@ShareStyle(share)">@Pct(share)</td> }
                            <td>@b.OwnerPlayers.ToString("N0")</td>
                            <td>@(b.OwnerPlayers > 0 ? b.AvgBuiltRound.ToString("0.0") : "—")</td>
                            <td>@(b.OwnerPlayers > 0 ? Pct(b.WinShareOwned) : "—")</td>
                            <td>@Pct(b.WinShareNotOwned)</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </details>
    }
    else if (a.HasGameRecords)
    {
        <div class="ok">@L.T("res.old_file")</div>
    }

    @if (a.HasGameRecords)
    {
        <div class="grid2">
            <div>
                <h2>@L.T("res.h.length")</h2>
                <figure class="chartbox">
                    <LineChart Title="@L.T("res.length_chart")" Width="440" YFormat="@(v => v.ToString("P0"))"
                               XLabels="@(Enumerable.Range(0, a.RoundCounts.Count).Select(n => n.ToString()).ToList())"
                               Series="@(new[] { new LineChart.LineSeries(L.T("res.length_series"), "var(--accent)", a.RoundCounts.Select(c => c / (double)Math.Max(1, a.GamesCompleted)).ToList()) })" />
                </figure>
            </div>
            <div>
                <h2>@L.T("res.h.reason")</h2>
                <figure class="chartbox">
                    <BarChart Title="@L.T("res.h.reason")" Width="@(L.Chinese ? 440 : 620)" LabelWidth="@(L.Chinese ? 150 : 310)" Format="@(v => v.ToString("P1"))"
                              Items="@(a.EndReasons.OrderByDescending(e => e.Value).Select(e => new BarChart.BarItem(L.EndReason(e.Key), e.Value / (double)Math.Max(1, a.GamesCompleted), 0, "var(--accent)",
                                   L.T("res.reason_tip", L.EndReason(e.Key), e.Value.ToString("N0")))).ToList())" />
                </figure>
            </div>
        </div>

        <h2>@L.T("res.h.pairwise")</h2>
        <p class="note">@L.T("res.pairwise_note")</p>
        <div class="tablewrap">
            <table class="data heat">
                <thead><tr><th></th>@for (int j = 0; j < strategies.Count; j++) { <th>@Name(j)</th> }</tr></thead>
                <tbody>
                @for (int i = 0; i < strategies.Count; i++)
                {
                    <tr>
                        <td><span class="swatch" style="background:@Color(i)"></span>@Name(i)</td>
                        @for (int j = 0; j < strategies.Count; j++)
                        {
                            double v = a.Pairwise[i][j];
                            <td class="cell" style="@HeatStyle(v)">@(double.IsNaN(v) ? "—" : v.ToString("P1"))</td>
                        }
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="ok">@((MarkupString)L.T("res.no_records"))</div>
    }

    <h2>@L.T("res.h.data")</h2>
    <details open>
        <summary>@L.T("res.per_strategy")</summary>
        <div class="tablewrap">
            <table class="data">
                <thead>
                    <tr><th>@L.T("res.th.strategy")</th><th>@L.T("res.th.games")</th><th>@L.T("res.th.win")</th><th>±95%</th><th>@L.T("res.th.avg")</th><th>@L.T("res.th.std")</th>
                    @if (a.HasGameRecords) { <th>P10</th><th>P50</th><th>P90</th><th>@L.T("res.th.chips")</th><th>@L.T("res.th.bld_pts")</th><th>@L.T("res.th.bonus")</th><th>@L.T("res.th.rank")</th><th>@L.T("res.th.top_half")</th><th>@L.T("res.th.last")</th> }</tr>
                </thead>
                <tbody>
                @for (int i = 0; i < strategies.Count; i++)
                {
                    var s = strategies[i];
                    <tr>
                        <td><span class="swatch" style="background:@Color(i)"></span>@Name(i)</td>
                        <td>@s.Games.ToString("N0")</td><td>@Pct(s.WinShare)</td><td>@Pct(s.WinShareCi95)</td>
                        <td>@s.AvgScore.ToString("0.0")</td><td>@s.StdScore.ToString("0.0")</td>
                        @if (a.HasGameRecords)
                        {
                            <td>@s.P10</td><td>@s.P50</td><td>@s.P90</td>
                            <td>@s.AvgChips.ToString("0.0")</td><td>@s.AvgBuildingPoints.ToString("0.0")</td><td>@s.AvgBonusPoints.ToString("0.0")</td>
                            <td>@s.MeanRank.ToString("0.00")</td><td>@Pct(s.TopHalfShare)</td><td>@Pct(s.LastPlaceShare)</td>
                        }
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </details>
    <details>
        <summary>@L.T("res.h.seat")</summary>
        <div class="tablewrap">
            <table class="data">
                <thead><tr><th>@L.T("res.th.seat")</th><th>@L.T("res.th.win")</th><th>@L.T("res.th.avg")</th></tr></thead>
                <tbody>@foreach (var t in a.TableSeats) { <tr><td>@L.T("sim.seat_n", t.Seat + 1)</td><td>@Pct(t.WinShare)</td><td>@t.AvgScore.ToString("0.0")</td></tr> }</tbody>
            </table>
        </div>
    </details>

    @if (a.HasGameRecords)
    {
        <h2>@L.T("res.h.games")</h2>
        <p class="note">@L.T("res.games_note")</p>
        <GameList Result="@r" Analysis="@a" Source="@State.Source" />
    }
}

@code {
    protected override void OnInitialized() => State.Changed += OnChanged;
    private void OnChanged() { copied = false; InvokeAsync(StateHasChanged); }
    public void Dispose() => State.Changed -= OnChanged;

    private bool copied;

    private async Task CopySummary(string text)
    {
        try { await JS.InvokeVoidAsync("prCopy", text); copied = true; }
        catch (JSException) { copied = false; }
    }

    private void SimulateAgain()
    {
        if (State.Result == null) return;
        State.SetTemplate(State.Result.Config, State.Source ?? L.T("res.current"));
        Nav.NavigateTo("simulate");
    }

    private static string ShareStyle(double share) =>
        FormattableString.Invariant($"background:color-mix(in srgb, var(--series-1) {Math.Clamp(share, 0, 1) * 70:0}%, var(--neutral))");

    private static string HeatStyle(double v)
    {
        if (double.IsNaN(v)) return "";
        double strength = Math.Abs(v - 0.5) * 2 * 85;
        string pole = v >= 0.5 ? "var(--pos)" : "var(--neg)";
        return FormattableString.Invariant($"background:color-mix(in srgb, {pole} {strength:0}%, var(--neutral))");
    }
}
