@page "/results"
@implements IDisposable
@inject AppState State
@inject NavigationManager Nav

<PageTitle>結果總覽 · 波多黎各策略模擬器</PageTitle>
<h1>結果總覽</h1>
<p class="note">載入 Runner 輸出的 result.json（<code>--out</code>），檢視策略勝率、分數與終局。策略顏色固定對應策略，不隨排名改變。</p>

<FilePicker>
    @if (State.Result != null && State.Sweep == null)
    {
        <button @onclick="SimulateAgain" title="把這份結果的玩家數、策略、參數、種子帶到「策略模擬」頁，可以修改後再跑">用這份設定再模擬</button>
    }
</FilePicker>

@if (State.Sweep != null)
{
    <div class="ok">目前載入的是參數掃描結果，請到「參數掃描」頁檢視。</div>
}
else if (State.Result != null && State.Analysis != null)
{
    var r = State.Result;
    var a = State.Analysis;
    var strategies = a.Strategies;
    string Pct(double v) => v.ToString("P1");
    string Color(int i) => Palette.Color(strategies[i].Strategy, i);
    string Name(int i) => Palette.Label(strategies[i].SeatId, strategies[i].Strategy);

    <div class="kpis">
        <div class="kpi"><div class="v">@a.GamesCompleted.ToString("N0")</div><div class="l">局數（@r.Status）</div></div>
        <div class="kpi"><div class="v">@r.Config.Players</div><div class="l">玩家數</div></div>
        <div class="kpi"><div class="v">@r.Config.Seed</div><div class="l">主種子</div></div>
        <div class="kpi"><div class="v">@Palette.SeatOrderLabel(r.Config.SeatOrder)</div><div class="l">座位順序</div></div>
        @if (a.HasGameRecords)
        {
            <div class="kpi"><div class="v">@a.AvgRounds.ToString("0.0")</div><div class="l">平均回合數</div></div>
            <div class="kpi"><div class="v">@a.AvgDecisions.ToString("0")</div><div class="l">平均決策數／局</div></div>
        }
        <div class="kpi"><div class="v">@r.EngineVersion</div><div class="l">引擎 · @r.RulesVersion</div></div>
    </div>
    @if (r.Status != "completed")
    {
        <div class="error">這份結果狀態是「@r.Status」，只含已跑完的 @a.GamesCompleted 局 / 預定 @r.GamesRequested 局。</div>
    }

    <div class="grid2">
    <div>
    <h2>策略勝率</h2>
    <p class="note">勝率 = 贏的局數比例（並列第一者平分）；誤差線 = 95% 信賴區間。隨機基準 = @((1.0 / r.Config.Players).ToString("P1"))。</p>
    <figure class="chartbox">
        <BarChart Title="策略勝率" Width="520" LabelWidth="170" Format="@(v => v.ToString("P1"))"
                  Items="@(strategies.Select((s, i) => (s, i)).OrderByDescending(x => x.s.WinShare).Select(x => new BarChart.BarItem(Name(x.i), x.s.WinShare, x.s.WinShareCi95, Color(x.i),
                       $"{Name(x.i)}　勝率 {Pct(x.s.WinShare)} ± {Pct(x.s.WinShareCi95)}（{x.s.Games:N0} 局）")).ToList())" />
    </figure>
    </div>

    <div>
    <h2>平均分數</h2>
    <p class="note">長條 = 平均總分；線段 = ±1 個標準差（分數的離散程度，越短越穩定）。</p>
    <figure class="chartbox">
        <BarChart Title="平均分數" Width="520" LabelWidth="170" Format="@(v => v.ToString("0.0"))"
                  Items="@(strategies.Select((s, i) => (s, i)).OrderByDescending(x => x.s.AvgScore).Select(x => new BarChart.BarItem(Name(x.i), x.s.AvgScore, x.s.StdScore, Color(x.i),
                       $"{Name(x.i)}　平均 {x.s.AvgScore:0.0}，標準差 {x.s.StdScore:0.0}")).ToList())" />
    </figure>
    </div>
    </div>

    <div class="grid2">
        <div>
            <h2>分數構成</h2>
            <p class="note">平均每局：出貨籌碼／建築分／大型建築加成；依總分由高到低排列。</p>
            <figure class="chartbox">
                <StackedBars Title="分數構成" Width="440" LabelWidth="150" Segments="@(new[] { "出貨籌碼（含額外 VP）", "建築分", "大型建築加成" })"
                             Rows="@(strategies.Select((s, i) => new StackedBars.StackRow(Name(i), new[] { s.AvgChips, s.AvgBuildingPoints, s.AvgBonusPoints })).OrderByDescending(r => r.Values.Sum()).ToList())" />
            </figure>
        </div>
        <div>
            <h2>座位優勢</h2>
            <p class="note">各桌位（座位 1 = 起始總督）的勝率。策略座位已輪換，這裡只反映桌位本身的優勢。</p>
            <figure class="chartbox">
                <BarChart Title="座位優勢" Width="440" LabelWidth="70" Format="@(v => v.ToString("P1"))"
                          Items="@(a.TableSeats.Select(t => new BarChart.BarItem($"座位 {t.Seat + 1}", t.WinShare, 0, "var(--accent)",
                               $"座位 {t.Seat + 1}　勝率 {Pct(t.WinShare)}，平均 {t.AvgScore:0.0} 分")).ToList())" />
            </figure>
        </div>
    </div>

    @if (a.HasGameRecords && a.HasBuildingRecords)
    {
        <h2>策略行為</h2>
        <p class="note">每局平均。港口取得率 = 該策略的局中有蓋到港口的比例，回合 = 蓋到港口的平均回合；出貨次數含 Wharf。</p>
        <div class="tablewrap">
            <table class="data">
                <thead>
                    <tr><th>策略</th><th>港口取得率</th><th>港口回合</th><th>建築數</th><th>大型建築</th><th>出貨次數</th>
                        <th>玉米園</th><th>染料園</th><th>糖園</th><th>菸草園</th><th>咖啡園</th><th>採石場</th><th>終局金幣</th></tr>
                </thead>
                <tbody>
                @for (int i = 0; i < strategies.Count; i++)
                {
                    var s = strategies[i];
                    <tr>
                        <td><span class="swatch" style="background:@Color(i)"></span>@Name(i)</td>
                        <td>@Pct(s.HarborShare)</td><td>@(s.HarborShare > 0 ? s.AvgHarborRound.ToString("0.0") : "—")</td>
                        <td>@s.AvgBuildings.ToString("0.0")</td><td>@s.AvgLargeBuildings.ToString("0.00")</td><td>@s.AvgShipments.ToString("0.0")</td>
                        @foreach (var t in s.AvgTiles) { <td>@t.ToString("0.0")</td> }
                        <td>@s.AvgCoins.ToString("0.0")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <h2>建築與勝率</h2>
        <p class="note">擁有該建築的玩家的勝率（所有策略合計），基準 = @((1.0 / r.Config.Players).ToString("P1"))。擁有人數少於 300 的建築不畫（樣本太少）。</p>
        <figure class="chartbox">
            <BarChart Title="擁有該建築的玩家勝率" LabelWidth="200" Format="@(v => v.ToString("P1"))"
                      Items="@(a.Buildings.Where(b => b.OwnerPlayers >= 300).OrderByDescending(b => b.WinShareOwned).Take(15)
                           .Select(b => new BarChart.BarItem(b.Name, b.WinShareOwned, PuertoRico.Engine.Simulation.ResultAnalysis.Ci(b.WinShareOwned, b.OwnerPlayers), "var(--accent)",
                               $"{b.Name}　擁有者 {b.OwnerPlayers:N0} 人，勝率 {Pct(b.WinShareOwned)}（未擁有 {Pct(b.WinShareNotOwned)}），平均第 {b.AvgBuiltRound:0.0} 回合購買")).ToList())" />
        </figure>
        <details>
            <summary>全部建築（取得率、購買回合、勝率）</summary>
            <div class="tablewrap">
                <table class="data heat">
                    <thead>
                        <tr><th>建築</th>@for (int j = 0; j < strategies.Count; j++) { <th>@Name(j)</th> }<th>擁有人數</th><th>平均購買回合</th><th>擁有者勝率</th><th>未擁有者勝率</th></tr>
                    </thead>
                    <tbody>
                    @foreach (var b in a.Buildings)
                    {
                        <tr>
                            <td>@b.Name</td>
                            @foreach (var share in b.OwnedShare) { <td class="cell" style="@ShareStyle(share)">@Pct(share)</td> }
                            <td>@b.OwnerPlayers.ToString("N0")</td>
                            <td>@(b.OwnerPlayers > 0 ? b.AvgBuiltRound.ToString("0.0") : "—")</td>
                            <td>@(b.OwnerPlayers > 0 ? Pct(b.WinShareOwned) : "—")</td>
                            <td>@Pct(b.WinShareNotOwned)</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </details>
    }
    else if (a.HasGameRecords)
    {
        <div class="ok">這份結果檔是舊版本寫的，沒有建築清單與行為統計；用新版 Runner 重跑就會有「策略行為」與「建築與勝率」。</div>
    }

    @if (a.HasGameRecords)
    {
        <div class="grid2">
            <div>
                <h2>局長（回合數）</h2>
                <figure class="chartbox">
                    <LineChart Title="局長" Width="440" YFormat="@(v => v.ToString("P0"))"
                               XLabels="@(Enumerable.Range(0, a.RoundCounts.Count).Select(n => n.ToString()).ToList())"
                               Series="@(new[] { new LineChart.LineSeries("局數比例", "var(--accent)", a.RoundCounts.Select(c => c / (double)Math.Max(1, a.GamesCompleted)).ToList()) })" />
                </figure>
            </div>
            <div>
                <h2>終局原因</h2>
                <figure class="chartbox">
                    <BarChart Title="終局原因" Width="440" LabelWidth="150" Format="@(v => v.ToString("P1"))"
                              Items="@(a.EndReasons.OrderByDescending(e => e.Value).Select(e => new BarChart.BarItem(ReasonName(e.Key), e.Value / (double)Math.Max(1, a.GamesCompleted), 0, "var(--accent)",
                                   $"{ReasonName(e.Key)}　{e.Value:N0} 局")).ToList())" />
                </figure>
            </div>
        </div>

        <h2>兩兩名次比較</h2>
        <p class="note">列策略的名次比欄策略高的機率（排除名次相同的局）。藍 = 列較強，紅 = 欄較強，灰 = 勢均力敵。</p>
        <div class="tablewrap">
            <table class="data heat">
                <thead><tr><th></th>@for (int j = 0; j < strategies.Count; j++) { <th>@Name(j)</th> }</tr></thead>
                <tbody>
                @for (int i = 0; i < strategies.Count; i++)
                {
                    <tr>
                        <td><span class="swatch" style="background:@Color(i)"></span>@Name(i)</td>
                        @for (int j = 0; j < strategies.Count; j++)
                        {
                            double v = a.Pairwise[i][j];
                            <td class="cell" style="@HeatStyle(v)">@(double.IsNaN(v) ? "—" : v.ToString("P1"))</td>
                        }
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="ok">這份結果沒有逐局記錄（<code>output.perGameRecords: false</code>），所以沒有局長、終局原因與名次比較。</div>
    }

    <h2>數據表</h2>
    <details open>
        <summary>各策略統計</summary>
        <div class="tablewrap">
            <table class="data">
                <thead>
                    <tr><th>策略</th><th>局數</th><th>勝率</th><th>±95%</th><th>平均分</th><th>標準差</th>
                    @if (a.HasGameRecords) { <th>P10</th><th>P50</th><th>P90</th><th>籌碼</th><th>建築</th><th>加成</th><th>平均名次</th><th>前半名</th><th>墊底</th> }</tr>
                </thead>
                <tbody>
                @for (int i = 0; i < strategies.Count; i++)
                {
                    var s = strategies[i];
                    <tr>
                        <td><span class="swatch" style="background:@Color(i)"></span>@Name(i)</td>
                        <td>@s.Games.ToString("N0")</td><td>@Pct(s.WinShare)</td><td>@Pct(s.WinShareCi95)</td>
                        <td>@s.AvgScore.ToString("0.0")</td><td>@s.StdScore.ToString("0.0")</td>
                        @if (a.HasGameRecords)
                        {
                            <td>@s.P10</td><td>@s.P50</td><td>@s.P90</td>
                            <td>@s.AvgChips.ToString("0.0")</td><td>@s.AvgBuildingPoints.ToString("0.0")</td><td>@s.AvgBonusPoints.ToString("0.0")</td>
                            <td>@s.MeanRank.ToString("0.00")</td><td>@Pct(s.TopHalfShare)</td><td>@Pct(s.LastPlaceShare)</td>
                        }
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </details>
    <details>
        <summary>座位優勢</summary>
        <div class="tablewrap">
            <table class="data">
                <thead><tr><th>座位</th><th>勝率</th><th>平均分</th></tr></thead>
                <tbody>@foreach (var t in a.TableSeats) { <tr><td>座位 @(t.Seat + 1)</td><td>@Pct(t.WinShare)</td><td>@t.AvgScore.ToString("0.0")</td></tr> }</tbody>
            </table>
        </div>
    </details>
}

@code {
    protected override void OnInitialized() => State.Changed += OnChanged;
    private void OnChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => State.Changed -= OnChanged;

    private void SimulateAgain()
    {
        if (State.Result == null) return;
        State.SetTemplate(State.Result.Config, State.Source ?? "目前結果");
        Nav.NavigateTo("simulate");
    }

    private static string ReasonName(string key)
    {
        if (string.IsNullOrEmpty(key)) return "（無）";
        var names = key.Split('+').Select(k => k switch
        {
            "vpExhausted" => "VP 籌碼耗盡",
            "colonistsShort" => "殖民者不足",
            "cityFull" => "城市蓋滿",
            "roundLimit" => "回合上限",
            "decisionLimit" => "決策上限",
            _ => k,
        });
        return string.Join(" ＋ ", names);
    }

    private static string ShareStyle(double share) =>
        FormattableString.Invariant($"background:color-mix(in srgb, var(--series-1) {Math.Clamp(share, 0, 1) * 70:0}%, var(--neutral))");

    private static string HeatStyle(double v)
    {
        if (double.IsNaN(v)) return "";
        double strength = Math.Abs(v - 0.5) * 2 * 85;
        string pole = v >= 0.5 ? "var(--pos)" : "var(--neg)";
        return FormattableString.Invariant($"background:color-mix(in srgb, {pole} {strength:0}%, var(--neutral))");
    }
}
