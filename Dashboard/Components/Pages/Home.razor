@page "/"

<PageTitle>@L.T("home.title")</PageTitle>

<section class="hero">
    <div class="herotext">
        <div class="herokicker">@L.T("home.kicker")</div>
        <h1 class="herotitle">@L.T("home.hero")</h1>
        <p class="herolead">@L.T("home.lead")</p>
        <div class="herocta">
            <a class="btn primary" href="simulate">@L.T("home.cta_simulate")</a>
            <a class="btn" href="results">@L.T("home.cta_results")</a>
        </div>
    </div>
    <div class="herogoods" aria-hidden="true">
        @for (int g = 0; g < 5; g++)
        {
            <div class="barrel" style="background:var(--good-@g)"><span>@L.T("good." + g)</span></div>
        }
    </div>
</section>
<p class="note">@L.T("home.note")</p>

<h2 class="promo">@L.T("home.steps")</h2>
<p class="promosub">@L.T("home.steps_sub")</p>
<div class="steps">
    <a class="step" href="simulate"><span class="stepno">1</span><strong>@L.T("home.s1")</strong><span>@L.T("home.s1_text")</span><span class="go">@L.T("home.s1_go")</span></a>
    <a class="step" href="results"><span class="stepno">2</span><strong>@L.T("home.s2")</strong><span>@L.T("home.s2_text")</span><span class="go">@L.T("home.s2_go")</span></a>
    <a class="step" href="replay"><span class="stepno">3</span><strong>@L.T("home.s3")</strong><span>@L.T("home.s3_text")</span><span class="go">@L.T("home.s3_go")</span></a>
</div>

<h2 class="promo">@L.T("home.more")</h2>
<p class="promosub">@L.T("home.more_sub")</p>
<div class="cards">
    <a class="card" href="overview"><span class="cicon">🏆</span><strong>@L.T("nav.overview")</strong>@L.T("home.c.overview")</a>
    <a class="card" href="compare"><span class="cicon">⚖️</span><strong>@L.T("nav.compare")</strong>@L.T("home.c.compare")</a>
    <a class="card" href="replay"><span class="cicon">🎬</span><strong>@L.T("nav.replay")</strong>@L.T("home.c.replay")</a>
    <a class="card" href="sweep"><span class="cicon">🎛️</span><strong>@L.T("nav.sweep")</strong>@L.T("home.c.sweep")</a>
    <a class="card" href="config"><span class="cicon">📝</span><strong>@L.T("nav.config")</strong>@L.T("home.c.config")</a>
</div>

<h2 class="promo">@L.T("home.roster", StrategyInfo.All(L).Count)</h2>
<p class="promosub">@L.T("home.roster_sub")</p>
@foreach (var g in StrategyInfo.Groups(L))
{
    <h3 class="rostergroup">@g.Title</h3>
    <div class="roster">
        @foreach (var s in StrategyInfo.InGroup(L, g.Key))
        {
            var pitch = (L.Has("home.badge." + s.Id) ? L.T("home.badge." + s.Id) : "", L.Has("home.pitch." + s.Id) ? L.T("home.pitch." + s.Id) : s.Summary);
            <a class="fighter" href="simulate#strategies" style="--c:@Palette.Color(s.Id, 0)" title="@s.Summary">
                @if (pitch.Item1 != "") { <span class="badge">@pitch.Item1</span> }
                <span class="ficon">@Palette.Icon(s.Id)</span>
                <span class="fbody"><strong>@Palette.DisplayName(s.Id)</strong><em>@s.Title</em><span>@pitch.Item2</span></span>
            </a>
        }
    </div>
}

<h2 class="promo">@L.T("home.tips")</h2>
<p class="promosub">@L.T("home.tips_sub")</p>
<div class="tips">
    <div class="tip"><span class="ticon">📏</span><div><strong>@L.T("home.t1")</strong>@L.T("home.t1_text")</div></div>
    <div class="tip"><span class="ticon">🪑</span><div><strong>@L.T("home.t2")</strong>@L.T("home.t2_text")</div></div>
    <div class="tip"><span class="ticon">🤝</span><div><strong>@L.T("home.t3")</strong>@L.T("home.t3_text")</div></div>
    <div class="tip"><span class="ticon">🔁</span><div><strong>@L.T("home.t4")</strong>@L.T("home.t4_text")</div></div>
    <div class="tip"><span class="ticon">🐢</span><div><strong>@L.T("home.t5")</strong>@L.T("home.t5_text")</div></div>
</div>

<details class="folders">
    <summary>@L.T("home.folders")</summary>
    <ul>
        <li><code>results</code>: @L.T("home.f.results")</li>
        <li>@((MarkupString)L.T("home.f.configs"))</li>
        <li>@((MarkupString)L.T("home.f.docs"))</li>
    </ul>
</details>
