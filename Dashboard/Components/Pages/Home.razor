    {
        ["corn-shipper"] = ("入門款", "狂種玉米，每次出貨都拿分。"),
        ["corn-to-premium"] = ("3 人局前段班", "先玉米，再改賣菸草／咖啡換金幣。"),
        ["corn-monopoly"] = ("志在參加", "霸占玉米，囤著不賣也不出貨。"),
        ["corn-monopoly-tiles"] = ("搶地專家", "只搶玉米種植園，貨照常出。"),
        ["corn-monopoly-hoard"] = ("囤貨專家", "不搶地，但玉米囤到天荒地老。"),
        ["harbor-rush"] = ("3 人局強權", "先蓋出港口，之後每次出貨多 1 分。"),
        ["wharf-rush"] = ("爭議角色", "湊錢買 Wharf，整堆貨一次丟上私船。"),
        ["wharf-premium"] = ("實驗款", "先賣高價貨，再買 Wharf。"),
