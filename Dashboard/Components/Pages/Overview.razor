@page "/overview"
@inject IConfiguration Config

<PageTitle>對戰總覽 · 波多黎各策略模擬器</PageTitle>
<h1>對戰總覽</h1>
<p class="note">勾選多份一般模擬結果檔（例如 <code>tournaments/</code> 跑出來的 4 人局全場與四種 3 人組合），依玩家數彙整每個策略：每張桌子的勝率取平均（每張桌子權重相同），並列出各桌的勝率。「優勢」= 平均勝率 − 均分基準（1/玩家數）。</p>

<div class="panel">
    <div class="row">
        <label>玩家數
            <select @bind="playersFilter">
                <option value="0">全部</option>
                <option value="3">3 人</option>
                <option value="4">4 人</option>
            </select>
        </label>
        <label>檔名或策略含 <input type="text" @bind="textFilter" @bind:event="oninput" placeholder="例如 harbor、4p" /></label>
        <button class="secondary" @onclick="Refresh">重新整理</button>
    </div>
    <div class="row" style="margin-top:.5rem">
        <label>預設組合
            <select @bind="presetName">
                <option value="">（@(presets.Count == 0 ? "尚無，先勾選檔案再儲存" : "選擇組合")）</option>
                @foreach (var n in presets.Keys.OrderBy(k => k, StringComparer.OrdinalIgnoreCase)) { <option value="@n">@n（@presets[n].Count 份）</option> }
            </select>
        </label>
        <button class="secondary" @onclick="ApplyPreset" disabled="@string.IsNullOrEmpty(presetName)">套用</button>
        <button class="secondary" @onclick="DeletePreset" disabled="@string.IsNullOrEmpty(presetName)">刪除</button>
        <span class="grow"></span>
        <label>另存勾選為 <input type="text" style="width:9rem" placeholder="組合名稱，例如 五選四" @bind="newPresetName" @bind:event="oninput" /></label>
        <button class="secondary" @onclick="SavePreset" disabled="@(selected.Count == 0 || string.IsNullOrWhiteSpace(newPresetName))">儲存</button>
    </div>
    @if (presetNote != null) { <div class="ok" style="margin-top:.4rem">@presetNote</div> }
    <div class="tablewrap" style="max-height:20rem; overflow-y:auto; margin-top:.5rem">
        <table class="data filetable">
            <thead>
                <tr>
                    <th class="chk"><input type="checkbox" title="全選／取消目前列出的檔案" checked="@AllShownSelected" disabled="@(shown.Count == 0)" @onchange="@(e => ToggleShown((bool)(e.Value ?? false)))" /></th>
                    <th class="left">檔名</th><th>人數</th><th>局數</th><th class="left">座位順序</th><th class="left">策略</th><th>大小</th><th class="left">修改時間</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var m in shown)
            {
                string file = m.Path;
                <tr class="@(selected.Contains(file) ? "picked" : "")" @onclick="@(() => Toggle(file, !selected.Contains(file)))">
                    <td class="chk"><input type="checkbox" checked="@selected.Contains(file)" @onclick:stopPropagation="true" @onchange="@(e => Toggle(file, (bool)(e.Value ?? false)))" /></td>
                    <td class="left">@m.Name</td>
                    <td>@m.Players</td>
                    <td>@m.Games.ToString("N0")</td>
                    <td class="left">@m.SeatOrder</td>
                    <td class="left wrapok">@m.Strategies</td>
                    <td>@m.Size</td>
                    <td class="left">@m.Modified</td>
                </tr>
            }
            @if (shown.Count == 0)
            {
                <tr><td colspan="8" class="muted left">@(metas.Count == 0 ? "資料夾內沒有可用的結果檔" : "沒有符合篩選條件的檔案")</td></tr>
            }
            </tbody>
        </table>
    </div>
    <div class="actionbar">
        <span class="muted">已選 <strong>@selected.Count</strong> 份 / 共 @metas.Count 份（目前列出 @shown.Count 份）</span>
        <span class="grow"></span>
        <button class="go" @onclick="Build" disabled="@(loading || !selected.Any())">@(loading ? "產生中…" : $"產生總覽（{selected.Count} 份）")</button>
    </div>
    <p class="note">掃描資料夾：@AppState.DisplayPath(dir)。點整列或勾選方塊即可選取；表頭的方塊會全選／取消目前列出的檔案（先用上方篩選縮小範圍）。參數掃描檔（sweep）與無法讀取的檔案不會列出；每份大檔載入需要幾秒。</p>
    @if (loading) { <p>載入中…（@done / @selected.Count）</p> }
    @foreach (var m in skipped) { <div class="error">略過：@m</div> }
</div>

@if (tables.Count > 0)
{
    var rows = TournamentOverview.Summarize(tables);
    foreach (int players in rows.Select(r => r.Players).Distinct().OrderBy(p => p))
    {
        var group = rows.Where(r => r.Players == players).ToList();
        var groupTables = tables.Where(t => t.Players == players).ToList();
        var orders = groupTables.Select(t => t.SeatOrder).Distinct().ToList();
        <h2>@players 人局（@groupTables.Count 張桌子）</h2>
        <p class="note">座位順序：@string.Join("、", orders.Select(o => Palette.SeatOrderLabel(o) + "（" + groupTables.Count(t => t.SeatOrder == o) + " 張）"))</p>
        @if (groupTables.Any(t => TournamentOverview.SeatOrderQuality(t) == "biased"))
        {
            <div class="error">這組有桌子用「輪換」或「固定」座位順序：同一桌只用一種循環排列，勝率可能偏差 20 個百分點以上，不能和其他桌直接比較強弱。建議用「隨機」或「完全平衡」重跑。</div>
        }
        else if (orders.Count > 1)
        {
            <div class="ok">這組的桌子座位順序不一致，平均勝率時請留意。</div>
        }
        <figure class="chartbox">
            <BarChart Title="@($"{players} 人局平均勝率")" LabelWidth="220" Format="@(v => v.ToString("P1"))"
                      Items="@(group.Select((r, i) => new BarChart.BarItem(Palette.DisplayName(r.Strategy), r.AvgWinShare, r.AvgWinShareCi95, Palette.Color(r.Strategy, i),
                           $"{Palette.DisplayName(r.Strategy)}　平均勝率 {r.AvgWinShare:P1} ± {r.AvgWinShareCi95:P1}（{r.Tables} 桌，範圍 {r.MinWinShare:P1}～{r.MaxWinShare:P1}），均分基準 {1.0 / players:P1}")).ToList())" />
        </figure>
        <div class="tablewrap">
            <table class="data">
                <thead><tr><th>策略</th><th>桌數</th><th>局數</th><th>平均勝率</th><th>±95%</th><th>優勢</th><th>最低～最高</th><th>平均分</th></tr></thead>
                <tbody>
                @foreach (var r in group)
                {
                    <tr>
                        <td>@Palette.DisplayName(r.Strategy)</td><td>@r.Tables</td><td>@r.Games.ToString("N0")</td>
                        <td>@r.AvgWinShare.ToString("P1")</td><td>@r.AvgWinShareCi95.ToString("P1")</td>
                        <td>@((r.Edge >= 0 ? "+" : "−") + Math.Abs(r.Edge * 100).ToString("0.0")) pp</td>
                        <td>@r.MinWinShare.ToString("P1")～@r.MaxWinShare.ToString("P1")</td>
                        <td>@r.AvgScore.ToString("0.0")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }

    @if (pairs.Count > 0)
    {
        <h2>兩兩對戰矩陣</h2>
        <p class="note">格子 = 列策略的名次高於欄策略的局數比例（平手不算），在兩者同桌的所有桌子上取平均；需要結果檔含逐局記錄。顏色越深代表列越占優勢。</p>
        foreach (int players in pairs.Select(p => p.Players).Distinct().OrderBy(p => p))
        {
            var names = pairs.Where(p => p.Players == players).SelectMany(p => new[] { p.A, p.B }).Distinct().OrderBy(n => n, StringComparer.Ordinal).ToList();
            <h3>@players 人局</h3>
            <div class="tablewrap">
                <table class="data heat">
                    <thead><tr><th>列 ＼ 欄</th>@foreach (var c in names) { <th>@Palette.DisplayName(c)</th> }</tr></thead>
                    <tbody>
                    @foreach (var rname in names)
                    {
                        <tr>
                            <td>@Palette.DisplayName(rname)</td>
                            @foreach (var c in names)
                            {
                                var cell = rname == c ? null : Lookup(players, rname, c);
                                <td class="cell" style="@(cell == null ? "" : HeatStyle(cell.Value))">@(rname == c ? "—" : cell == null ? "（沒同桌）" : cell.Value.ToString("P0"))</td>
                            }
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    }

    <h2>各桌明細</h2>
    <div class="tablewrap">
        <table class="data">
            <thead><tr><th>檔案</th><th>人數</th><th>局數</th><th>座位順序</th><th>座位（勝率／平均分）</th></tr></thead>
            <tbody>
            @foreach (var t in tables.OrderBy(t => t.Players).ThenBy(t => t.Name, StringComparer.OrdinalIgnoreCase))
            {
                <tr>
                    <td>@t.Name</td><td>@t.Players</td><td>@t.Games.ToString("N0")</td>
                    <td class="@(TournamentOverview.SeatOrderQuality(t) == "biased" ? "warn" : "")">@SeatOrderText(t)</td>
                    <td>@string.Join("；", t.Seats.OrderByDescending(s => s.WinShare).Select(s => $"{Palette.DisplayName(s.Strategy)} {s.WinShare:P1}／{s.AvgScore:0.0}"))</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

@code {
    private string dir = "";
    private sealed record FileMeta(string Path, string Name, int Players, int Games, string SeatOrder, string Strategies, string Size, string Modified);
    private List<FileMeta> metas = new();
    private int playersFilter;
    private string textFilter = "";
    private Dictionary<string, List<string>> presets = new();
    private string presetName = "", newPresetName = "";
    private string? presetNote;
    private readonly HashSet<string> selected = new();
    private readonly List<OverviewTable> tables = new();
    private readonly List<string> skipped = new();
    private bool loading;
    private int done;
    private List<OverviewPairRow> pairs = new();

    private static string SeatOrderText(OverviewTable t) => TournamentOverview.SeatOrderQuality(t) switch
    {
        "exact" => "完全平衡",
        "approx" => $"完全平衡（局數不是 {(t.Players == 3 ? 6 : 24)} 的倍數，近似）",
        "fair" => "隨機",
        _ => $"{Palette.SeatOrderLabel(t.SeatOrder)}（有排列偏差）",
    };

    /// <summary>Share of games where <paramref name="a"/> ranked above <paramref name="b"/>; stored once per ordered pair (A &lt; B), the reverse is the complement.</summary>
    private double? Lookup(int players, string a, string b)
    {
        var p = pairs.FirstOrDefault(x => x.Players == players && x.A == a && x.B == b);
        return p != null ? p.AAboveB : pairs.FirstOrDefault(x => x.Players == players && x.A == b && x.B == a) is { } q ? 1 - q.AAboveB : null;
    }

    private static string HeatStyle(double v) =>
        FormattableString.Invariant($"background:color-mix(in srgb, var(--series-1) {Math.Clamp(Math.Abs(v - 0.5) * 2, 0, 1) * 70:0}%, var(--neutral))");

    private IReadOnlyList<FileMeta> shown => metas
        .Where(m => (playersFilter == 0 || m.Players == playersFilter)
                    && (textFilter.Length == 0 || m.Name.Contains(textFilter, StringComparison.OrdinalIgnoreCase) || m.Strategies.Contains(textFilter, StringComparison.OrdinalIgnoreCase)))
        .ToList();

    private bool AllShownSelected => shown.Count > 0 && shown.All(m => selected.Contains(m.Path));

    protected override async Task OnInitializedAsync()
    {
        dir = AppState.ResultsDirectory(Config);
        await Refresh();
    }

    /// <summary>Lists the result files with their settings (read from each file's config only, which is fast even for big files).</summary>
    private async Task Refresh()
    {
        var list = new List<FileMeta>();
        if (Directory.Exists(dir))
        {
            var paths = Directory.GetFiles(dir, "*.json")
                .Where(f => !f.EndsWith(".tmp") && !System.IO.Path.GetFileName(f).StartsWith("sweep", StringComparison.OrdinalIgnoreCase))
                .OrderByDescending(f => File.GetLastWriteTime(f)).ToList();
            foreach (var f in paths)
            {
                try
                {
                    var c = await AppState.ReadConfigAsync(f);
                    if (c.Seats.Count == 0 || c.Sweep != null) continue;
                    var fi = new FileInfo(f);
                    var names = c.Seats.Select(x => x.Strategy.Equals("rule-based", StringComparison.OrdinalIgnoreCase) && x.Params.TryGetValue("profile", out var pr) ? pr.ToString() : x.Strategy)
                        .Select(Palette.DisplayName).ToList();
                    list.Add(new FileMeta(f, System.IO.Path.GetFileNameWithoutExtension(f), c.Players, c.Games, Palette.SeatOrderLabel(c.SeatOrder),
                        string.Join("、", names.Distinct()), fi.Length >= 1048576 ? $"{fi.Length / 1048576.0:0.#} MB" : $"{Math.Max(1, fi.Length / 1024)} KB", fi.LastWriteTime.ToString("yyyy-MM-dd HH:mm")));
                }
                catch (Exception e) when (e is System.Text.Json.JsonException or InvalidDataException or IOException) { }
            }
        }
        metas = list;
        presets = OverviewPresets.Load(dir);
        selected.RemoveWhere(f => !metas.Any(m => m.Path == f));
    }

    /// <summary>Selects exactly the files of the preset that still exist (a filter that hides some of them is cleared).</summary>
    private void ApplyPreset()
    {
        if (!presets.TryGetValue(presetName, out var names)) return;
        var found = metas.Where(m => names.Contains(System.IO.Path.GetFileName(m.Path), StringComparer.OrdinalIgnoreCase)).Select(m => m.Path).ToList();
        selected.Clear();
        foreach (var f in found) selected.Add(f);
        playersFilter = 0; textFilter = "";
        presetNote = $"已套用「{presetName}」：選取 {found.Count} 份" + (found.Count < names.Count ? $"（有 {names.Count - found.Count} 份檔案已不存在）" : "") + "。";
    }

    private void SavePreset()
    {
        string name = newPresetName.Trim();
        bool replaced = presets.ContainsKey(name);
        OverviewPresets.Save(dir, name, selected);
        presets = OverviewPresets.Load(dir);
        presetName = name; newPresetName = "";
        presetNote = $"已{(replaced ? "更新" : "儲存")}組合「{name}」（{selected.Count} 份）。";
    }

    private void DeletePreset()
    {
        OverviewPresets.Delete(dir, presetName);
        presetNote = $"已刪除組合「{presetName}」。";
        presets = OverviewPresets.Load(dir);
        presetName = "";
    }

    private void ToggleShown(bool on) { foreach (var m in shown) { if (on) selected.Add(m.Path); else selected.Remove(m.Path); } }
    private void Toggle(string f, bool on) { if (on) selected.Add(f); else selected.Remove(f); }

    private async Task Build()
    {
        loading = true; done = 0; tables.Clear(); skipped.Clear(); StateHasChanged();
        foreach (var f in selected.OrderBy(f => f, StringComparer.OrdinalIgnoreCase).ToList())
        {
            try { tables.Add(await AppState.ReadOverviewAsync(f)); }
            catch (Exception e) when (e is System.Text.Json.JsonException or InvalidDataException or IOException) { skipped.Add($"{Path.GetFileName(f)}：{AppState.Scrub(e.Message)}"); }
            done++; StateHasChanged();
        }
        pairs = TournamentOverview.Pairwise(tables);
        loading = false;
    }
}
