@page "/overview"
@implements IDisposable
@inject IConfiguration Config
@inject PageMemory Memory

<PageTitle>@L.T("ov.page_title")</PageTitle>
<h1>@L.T("nav.overview")</h1>
<p class="note">@((MarkupString)L.T("ov.intro"))</p>

<div class="panel">
    <div class="qf-bar">
        <QuickFilter T="int" Label="@L.T("ov.players")" @bind-Value="playersFilter" AllValue="0" Options="@(new[] { (3, L.T("sim.p3")), (4, L.T("sim.p4")) })" />
        <label>@L.T("ov.filter") <input type="text" @bind="textFilter" @bind:event="oninput" placeholder="@L.T("ov.filter_ph")" /></label>
        <button class="secondary" @onclick="Refresh">@L.T("sim.refresh")</button>
    </div>
    <div class="row" style="margin-top:.5rem">
        <label>@L.T("ov.preset")
            <select @bind="presetName">
                <option value="">(@(presets.Count == 0 ? L.T("ov.preset_none") : L.T("ov.preset_choose")))</option>
                @foreach (var n in presets.Keys.OrderBy(k => k, StringComparer.OrdinalIgnoreCase)) { <option value="@n">@L.T("ov.preset_item", n, presets[n].Count)</option> }
            </select>
        </label>
        <button class="secondary" @onclick="ApplyPreset" disabled="@string.IsNullOrEmpty(presetName)">@L.T("sim.apply")</button>
        <button class="secondary" @onclick="DeletePreset" disabled="@string.IsNullOrEmpty(presetName)">@L.T("ov.delete")</button>
        <span class="grow"></span>
        <label>@L.T("ov.save_as") <input type="text" style="width:9rem" placeholder="@L.T("ov.save_ph")" @bind="newPresetName" @bind:event="oninput" /></label>
        <button class="secondary" @onclick="SavePreset" disabled="@(selected.Count == 0 || string.IsNullOrWhiteSpace(newPresetName))">@L.T("ov.save")</button>
    </div>
    @if (presetNote != null) { <div class="ok" style="margin-top:.4rem">@presetNote</div> }
    <div class="tablewrap" style="max-height:20rem; overflow-y:auto; margin-top:.5rem">
        <table class="data filetable">
            <thead>
                <tr>
                    <th class="chk"><input type="checkbox" title="@L.T("ov.check_title")" checked="@AllShownSelected" disabled="@(shown.Count == 0)" @onchange="@(e => ToggleShown((bool)(e.Value ?? false)))" /></th>
                    <th class="left">@L.T("ov.th.file")</th><th>@L.T("ov.th.players")</th><th>@L.T("ov.th.games")</th><th class="left">@L.T("ov.th.order")</th><th class="left">@L.T("ov.th.strategies")</th><th>@L.T("ov.th.size")</th><th class="left">@L.T("ov.th.modified")</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var m in shown)
            {
                string file = m.Path;
                <tr class="@(selected.Contains(file) ? "picked" : "")" @onclick="@(() => Toggle(file, !selected.Contains(file)))">
                    <td class="chk"><input type="checkbox" checked="@selected.Contains(file)" @onclick:stopPropagation="true" @onchange="@(e => Toggle(file, (bool)(e.Value ?? false)))" /></td>
                    <td class="left">@m.Name</td>
                    <td>@m.Players</td>
                    <td>@m.Games.ToString("N0")</td>
                    <td class="left">@m.SeatOrder</td>
                    <td class="left wrapok">@m.Strategies</td>
                    <td>@m.Size</td>
                    <td class="left">@m.Modified</td>
                </tr>
            }
            @if (shown.Count == 0)
            {
                <tr><td colspan="8" class="muted left">@(metas.Count == 0 ? L.T("ov.empty_folder") : L.T("ov.empty_filter"))</td></tr>
            }
            </tbody>
        </table>
    </div>
    <div class="actionbar">
        <span class="muted">@((MarkupString)L.T("ov.selected", selected.Count, metas.Count, shown.Count))</span>
        <span class="grow"></span>
        <button class="go" @onclick="Build" disabled="@(loading || !selected.Any())">@(loading ? L.T("ov.building") : L.T("ov.build", selected.Count))</button>
    </div>
    <p class="note">@L.T("ov.note", AppState.DisplayPath(dir))</p>
    @if (loading) { <p>@L.T("ov.loading", done, selected.Count)</p> }
    @foreach (var m in skipped) { <div class="error">@L.T("ov.skipped", m)</div> }
</div>

@if (tables.Count > 0)
{
    var rows = TournamentOverview.Summarize(tables);
    foreach (int players in rows.Select(r => r.Players).Distinct().OrderBy(p => p))
    {
        var group = rows.Where(r => r.Players == players).ToList();
        var groupTables = tables.Where(t => t.Players == players).ToList();
        var orders = groupTables.Select(t => t.SeatOrder).Distinct().ToList();
        <h2>@L.T("ov.group", players, groupTables.Count)</h2>
        <p class="note">@L.T("ov.seat_orders", string.Join(L.T("common.list"), orders.Select(o => o + " (" + groupTables.Count(t => t.SeatOrder == o) + " tables)")))</p>
        @if (groupTables.Any(t => TournamentOverview.SeatOrderQuality(t) == "biased"))
        {
            <div class="error">@L.T("ov.biased")</div>
        }
        else if (orders.Count > 1)
        {
            <div class="ok">@L.T("ov.mixed")</div>
        }
        <figure class="chartbox">
            <BarChart Title="@L.T("ov.chart", players)" LabelWidth="220" Format="@(v => v.ToString("P1"))"
                      Items="@(group.Select((r, i) => new BarChart.BarItem(Palette.DisplayName(r.Strategy), r.AvgWinShare, r.AvgWinShareCi95, Palette.Color(r.Strategy, i),
                           L.T("ov.tip", Palette.DisplayName(r.Strategy), r.AvgWinShare.ToString("P1"), r.AvgWinShareCi95.ToString("P1"), r.Tables, r.MinWinShare.ToString("P1"), r.MaxWinShare.ToString("P1"), (1.0 / players).ToString("P1")))).ToList())" />
        </figure>
        <div class="tablewrap">
            <table class="data">
                <thead><tr><th>@L.T("ov.th.strategy")</th><th>@L.T("ov.th.tables")</th><th>@L.T("ov.th.games")</th><th>@L.T("ov.th.avg_win")</th><th>±95%</th><th>@L.T("ov.th.edge")</th><th>@L.T("ov.th.range")</th><th>@L.T("ov.th.avg_score")</th></tr></thead>
                <tbody>
                @foreach (var r in group)
                {
                    <tr>
                        <td>@Palette.DisplayName(r.Strategy)</td><td>@r.Tables</td><td>@r.Games.ToString("N0")</td>
                        <td>@r.AvgWinShare.ToString("P1")</td><td>@r.AvgWinShareCi95.ToString("P1")</td>
                        <td>@((r.Edge >= 0 ? "+" : "−") + Math.Abs(r.Edge * 100).ToString("0.0")) pp</td>
                        <td>@L.T("ov.range", r.MinWinShare.ToString("P1"), r.MaxWinShare.ToString("P1"))</td>
                        <td>@r.AvgScore.ToString("0.0")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }

    @if (pairs.Count > 0)
    {
        <h2>@L.T("ov.h.matrix")</h2>
        <p class="note">@L.T("ov.matrix_note")</p>
        foreach (int players in pairs.Select(p => p.Players).Distinct().OrderBy(p => p))
        {
            var names = pairs.Where(p => p.Players == players).SelectMany(p => new[] { p.A, p.B }).Distinct().OrderBy(n => n, StringComparer.Ordinal).ToList();
            <h3>@L.T("ov.pg", players)</h3>
            <div class="tablewrap">
                <table class="data heat">
                    <thead><tr><th>@L.T("ov.row_col")</th>@foreach (var c in names) { <th>@Palette.DisplayName(c)</th> }</tr></thead>
                    <tbody>
                    @foreach (var rname in names)
                    {
                        <tr>
                            <td>@Palette.DisplayName(rname)</td>
                            @foreach (var c in names)
                            {
                                var cell = rname == c ? null : Lookup(players, rname, c);
                                <td class="cell" style="@(cell == null ? "" : HeatStyle(cell.Value))">@(rname == c ? "—" : cell == null ? L.T("ov.never") : cell.Value.ToString("P0"))</td>
                            }
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    }

    <h2>@L.T("ov.h.details")</h2>
    <div class="tablewrap">
        <table class="data">
            <thead><tr><th>@L.T("ov.th.file2")</th><th>@L.T("ov.th.players")</th><th>@L.T("ov.th.games")</th><th>@L.T("ov.th.order")</th><th>@L.T("ov.th.seats")</th></tr></thead>
            <tbody>
            @foreach (var t in tables.OrderBy(t => t.Players).ThenBy(t => t.Name, StringComparer.OrdinalIgnoreCase))
            {
                <tr>
                    <td>@t.Name</td><td>@t.Players</td><td>@t.Games.ToString("N0")</td>
                    <td class="@(TournamentOverview.SeatOrderQuality(t) == "biased" ? "warn" : "")">@SeatOrderText(t)</td>
                    <td>@string.Join(L.T("common.sep"), t.Seats.OrderByDescending(s => s.WinShare).Select(s => $"{Palette.DisplayName(s.Strategy)} {s.WinShare:P1} / {s.AvgScore:0.0}"))</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

@code {
    private string dir = "";
    private sealed record FileMeta(string Path, string Name, int Players, int Games, string SeatOrder, string Strategies, string Size, string Modified);
    private List<FileMeta> metas = new();
    private bool metasReady;
    private int playersFilter;
    private string textFilter = "";
    private Dictionary<string, List<string>> presets = new();
    private string presetName = "", newPresetName = "";
    private string? presetNote;
    private HashSet<string> selected = new();
    private List<OverviewTable> tables = new();
    private List<string> skipped = new();
    private bool loading;
    private int done;
    private List<OverviewPairRow> pairs = new();

    private static string SeatOrderText(OverviewTable t) => TournamentOverview.SeatOrderQuality(t) switch
    {
        "exact" => "Balanced",
        "approx" => $"Balanced (approx.: games not a multiple of {(t.Players == 3 ? 6 : 24)})",
        "fair" => "Random",
        _ => $"{t.SeatOrder} (order bias)",
    };

    /// <summary>Share of games where <paramref name="a"/> ranked above <paramref name="b"/>; stored once per ordered pair (A &lt; B), the reverse is the complement.</summary>
    private double? Lookup(int players, string a, string b)
    {
        var p = pairs.FirstOrDefault(x => x.Players == players && x.A == a && x.B == b);
        return p != null ? p.AAboveB : pairs.FirstOrDefault(x => x.Players == players && x.A == b && x.B == a) is { } q ? 1 - q.AAboveB : null;
    }

    private static string HeatStyle(double v) =>
        FormattableString.Invariant($"background:color-mix(in srgb, var(--series-1) {Math.Clamp(Math.Abs(v - 0.5) * 2, 0, 1) * 70:0}%, var(--neutral))");

    private IReadOnlyList<FileMeta> shown => metas
        .Where(m => (playersFilter == 0 || m.Players == playersFilter)
                    && (textFilter.Length == 0 || m.Name.Contains(textFilter, StringComparison.OrdinalIgnoreCase) || m.Strategies.Contains(textFilter, StringComparison.OrdinalIgnoreCase)))
        .ToList();

    private bool AllShownSelected => shown.Count > 0 && shown.All(m => selected.Contains(m.Path));

    private sealed record Snap(List<FileMeta> Metas, int PlayersFilter, string TextFilter, Dictionary<string, List<string>> Presets,
        string PresetName, string NewPresetName, string? PresetNote, HashSet<string> Selected, List<OverviewTable> Tables, List<string> Skipped, List<OverviewPairRow> Pairs);

    protected override async Task OnInitializedAsync()
    {
        dir = AppState.ResultsDirectory(Config);
        // coming back from another page: show what was there (the file list is not scanned again, "Refresh" does that)
        if (Memory.Get<Snap>("overview") is { } m)
        {
            metas = m.Metas; playersFilter = m.PlayersFilter; textFilter = m.TextFilter; presets = m.Presets;
            presetName = m.PresetName; newPresetName = m.NewPresetName; presetNote = m.PresetNote; selected = m.Selected;
            tables = m.Tables; skipped = m.Skipped; pairs = m.Pairs;
            metasReady = true;
            return;
        }
        await Refresh();
    }

    /// <summary>A page left while its file list was still being read has nothing worth remembering: the next visit reads it again.</summary>
    public void Dispose()
    {
        if (!metasReady || loading) { Memory.Forget("overview"); return; }
        Memory.Set("overview", new Snap(metas, playersFilter, textFilter, presets, presetName, newPresetName, presetNote, selected, tables, skipped, pairs));
    }

    /// <summary>Lists the result files with their settings (read from each file's config only, which is fast even for big files).</summary>
    private async Task Refresh()
    {
        var list = new List<FileMeta>();
        if (Directory.Exists(dir))
        {
            var paths = ResultFiles.List(dir)
                .Where(f => !System.IO.Path.GetFileName(f).StartsWith("sweep", StringComparison.OrdinalIgnoreCase))
                .OrderByDescending(f => File.GetLastWriteTime(f)).ToList();
            foreach (var f in paths)
            {
                try
                {
                    var c = await AppState.ReadConfigAsync(f);
                    if (c.Seats.Count == 0 || c.Sweep != null) continue;
                    var fi = new FileInfo(f);
                    var names = c.Seats.Select(x => x.Strategy.Equals("rule-based", StringComparison.OrdinalIgnoreCase) && x.Params.TryGetValue("profile", out var pr) ? pr.ToString() : x.Strategy)
                        .Select(Palette.DisplayName).ToList();
                    list.Add(new FileMeta(f, System.IO.Path.ChangeExtension(ResultFiles.Label(dir, f), null), c.Players, c.Games, c.SeatOrder.ToString(),
                        string.Join(L.T("common.list"), names.Distinct()), fi.Length >= 1048576 ? $"{fi.Length / 1048576.0:0.#} MB" : $"{Math.Max(1, fi.Length / 1024)} KB", fi.LastWriteTime.ToString("yyyy-MM-dd HH:mm")));
                }
                catch (Exception e) when (e is System.Text.Json.JsonException or InvalidDataException or LocException or IOException) { }
            }
        }
        metas = list;
        metasReady = true;
        presets = OverviewPresets.Load(dir);
        selected.RemoveWhere(f => !metas.Any(m => m.Path == f));
    }

    /// <summary>Selects exactly the files of the preset that still exist (a filter that hides some of them is cleared).</summary>
    private void ApplyPreset()
    {
        if (!presets.TryGetValue(presetName, out var names)) return;
        var found = metas.Where(m => names.Contains(System.IO.Path.GetFileName(m.Path), StringComparer.OrdinalIgnoreCase)).Select(m => m.Path).ToList();
        selected.Clear();
        foreach (var f in found) selected.Add(f);
        playersFilter = 0; textFilter = "";
        presetNote = L.T("ov.note.applied", presetName, found.Count) + (found.Count < names.Count ? L.T("ov.note.missing", names.Count - found.Count) : "") + L.T("ov.note.end");
    }

    private void SavePreset()
    {
        string name = newPresetName.Trim();
        bool replaced = presets.ContainsKey(name);
        OverviewPresets.Save(dir, name, selected);
        presets = OverviewPresets.Load(dir);
        presetName = name; newPresetName = "";
        presetNote = L.T(replaced ? "ov.note.updated" : "ov.note.saved", name, selected.Count);
    }

    private void DeletePreset()
    {
        OverviewPresets.Delete(dir, presetName);
        presetNote = L.T("ov.note.deleted", presetName);
        presets = OverviewPresets.Load(dir);
        presetName = "";
    }

    private void ToggleShown(bool on) { foreach (var m in shown) { if (on) selected.Add(m.Path); else selected.Remove(m.Path); } }
    private void Toggle(string f, bool on) { if (on) selected.Add(f); else selected.Remove(f); }

    private async Task Build()
    {
        loading = true; done = 0; tables.Clear(); skipped.Clear(); StateHasChanged();
        foreach (var f in selected.OrderBy(f => f, StringComparer.OrdinalIgnoreCase).ToList())
        {
            try { tables.Add(await AppState.ReadOverviewAsync(f)); }
            catch (Exception e) when (e is System.Text.Json.JsonException or InvalidDataException or LocException or IOException) { skipped.Add($"{Path.GetFileName(f)}：{AppState.Scrub(L.Describe(e))}"); }
            done++; StateHasChanged();
        }
        pairs = TournamentOverview.Pairwise(tables);
        loading = false;
    }
}
