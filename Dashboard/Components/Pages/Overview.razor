@page "/overview"
@inject IConfiguration Config

<PageTitle>對戰總覽 · 波多黎各策略模擬器</PageTitle>
<h1>對戰總覽</h1>
<p class="note">勾選多份一般模擬結果檔（例如 <code>tournaments/</code> 跑出來的 4 人局全場與四種 3 人組合），依玩家數彙整每個策略：每張桌子的勝率取平均（每張桌子權重相同），並列出各桌的勝率。「優勢」= 平均勝率 − 均分基準（1/玩家數）。</p>

<div class="panel">
    <div class="row">
        <button @onclick="SelectAll" class="secondary">全選</button>
        <button @onclick="SelectNone" class="secondary">全不選</button>
        <button @onclick="Refresh" class="secondary">重新整理</button>
        <button @onclick="Build" disabled="@(loading || !selected.Any())">產生總覽（@selected.Count 份）</button>
    </div>
    <div class="row" style="margin-top:.5rem">
        @foreach (var f in files)
        {
            string file = f;
            <label><input type="checkbox" checked="@selected.Contains(file)" @onchange="@(e => Toggle(file, (bool)(e.Value ?? false)))" /> @Path.GetFileName(f)</label>
        }
        @if (files.Count == 0) { <span class="muted">資料夾內沒有 .json</span> }
    </div>
    <p class="note">掃描資料夾：@dir。參數掃描檔（sweep）會被略過；每份大檔載入需要幾秒。</p>
    @if (loading) { <p>載入中…（@done / @selected.Count）</p> }
    @foreach (var m in skipped) { <div class="error">略過：@m</div> }
</div>

@if (tables.Count > 0)
{
    var rows = TournamentOverview.Summarize(tables);
    foreach (int players in rows.Select(r => r.Players).Distinct().OrderBy(p => p))
    {
        var group = rows.Where(r => r.Players == players).ToList();
        <h2>@players 人局（@tables.Count(t => t.Players == players) 張桌子）</h2>
        <figure class="chartbox">
            <BarChart Title="@($"{players} 人局平均勝率")" LabelWidth="220" Format="@(v => v.ToString("P1"))"
                      Items="@(group.Select((r, i) => new BarChart.BarItem(Palette.DisplayName(r.Strategy), r.AvgWinShare, 0, Palette.Color(r.Strategy, i),
                           $"{Palette.DisplayName(r.Strategy)}　平均勝率 {r.AvgWinShare:P1}（{r.Tables} 桌，範圍 {r.MinWinShare:P1}～{r.MaxWinShare:P1}），均分基準 {1.0 / players:P1}")).ToList())" />
        </figure>
        <div class="tablewrap">
            <table class="data">
                <thead><tr><th>策略</th><th>桌數</th><th>局數</th><th>平均勝率</th><th>優勢</th><th>最低～最高</th><th>平均分</th></tr></thead>
                <tbody>
                @foreach (var r in group)
                {
                    <tr>
                        <td>@Palette.DisplayName(r.Strategy)</td><td>@r.Tables</td><td>@r.Games.ToString("N0")</td>
                        <td>@r.AvgWinShare.ToString("P1")</td>
                        <td>@((r.Edge >= 0 ? "+" : "−") + Math.Abs(r.Edge * 100).ToString("0.0")) pp</td>
                        <td>@r.MinWinShare.ToString("P1")～@r.MaxWinShare.ToString("P1")</td>
                        <td>@r.AvgScore.ToString("0.0")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }

    <h2>各桌明細</h2>
    <div class="tablewrap">
        <table class="data">
            <thead><tr><th>檔案</th><th>人數</th><th>局數</th><th>座位（勝率／平均分）</th></tr></thead>
            <tbody>
            @foreach (var t in tables.OrderBy(t => t.Players).ThenBy(t => t.Name, StringComparer.OrdinalIgnoreCase))
            {
                <tr>
                    <td>@t.Name</td><td>@t.Players</td><td>@t.Games.ToString("N0")</td>
                    <td>@string.Join("；", t.Seats.OrderByDescending(s => s.WinShare).Select(s => $"{Palette.DisplayName(s.Strategy)} {s.WinShare:P1}／{s.AvgScore:0.0}"))</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

@code {
    private string dir = "";
    private List<string> files = new();
    private readonly HashSet<string> selected = new();
    private readonly List<OverviewTable> tables = new();
    private readonly List<string> skipped = new();
    private bool loading;
    private int done;

    protected override void OnInitialized()
    {
        dir = AppState.ResultsDirectory(Config);
        Refresh();
    }

    private void Refresh()
    {
        files = Directory.Exists(dir)
            ? Directory.GetFiles(dir, "*.json").Where(f => !f.EndsWith(".tmp") && !Path.GetFileName(f).StartsWith("sweep", StringComparison.OrdinalIgnoreCase))
                .OrderBy(f => f, StringComparer.OrdinalIgnoreCase).ToList()
            : new List<string>();
        selected.RemoveWhere(f => !files.Contains(f));
    }

    private void SelectAll() { foreach (var f in files) selected.Add(f); }
    private void SelectNone() => selected.Clear();
    private void Toggle(string f, bool on) { if (on) selected.Add(f); else selected.Remove(f); }

    private async Task Build()
    {
        loading = true; done = 0; tables.Clear(); skipped.Clear(); StateHasChanged();
        foreach (var f in selected.OrderBy(f => f, StringComparer.OrdinalIgnoreCase).ToList())
        {
            try { tables.Add(await AppState.ReadOverviewAsync(f)); }
            catch (Exception e) when (e is System.Text.Json.JsonException or InvalidDataException or IOException) { skipped.Add($"{Path.GetFileName(f)}：{e.Message}"); }
            done++; StateHasChanged();
        }
        loading = false;
    }
}
