@page "/compare"
@implements IDisposable
@inject IConfiguration Config
@inject PageMemory Memory

<PageTitle>@L.T("cmp.page_title")</PageTitle>
<h1>@L.T("nav.compare")</h1>
<p class="note">@L.T("cmp.intro")</p>

<div class="panel">
    <div class="row">
        <label>@L.T("cmp.a")
            <select @bind="pathA"><option value="">(@L.T("fp.choose"))</option>@foreach (var f in files) { <option value="@f">@ResultFiles.Label(dir, f)</option> }</select>
        </label>
        <label>@L.T("cmp.b")
            <select @bind="pathB"><option value="">(@L.T("fp.choose"))</option>@foreach (var f in files) { <option value="@f">@ResultFiles.Label(dir, f)</option> }</select>
        </label>
        <button @onclick="Load" disabled="@(string.IsNullOrEmpty(pathA) || string.IsNullOrEmpty(pathB) || loading)">@L.T("cmp.run")</button>
        <button class="secondary" @onclick="Refresh">@L.T("sim.refresh")</button>
    </div>
    <p class="note">@L.T("cmp.folder", AppState.DisplayPath(dir))</p>
    @if (loading) { <p>@L.T("fp.loading")</p> }
    @if (error != null) { <div class="error">@error</div> }
</div>

@if (rows != null && ra != null && rb != null)
{
    string Pct(double v) => v.ToString("P1");
    string Signed(double v) => (v >= 0 ? "+" : "−") + Math.Abs(v * 100).ToString("0.0") + " pp";
    <div class="kpis">
        <div class="kpi"><div class="v">@ra.GamesCompleted.ToString("N0")</div><div class="l">@L.T("cmp.kpi_a", resA!.Config.Players)</div></div>
        <div class="kpi"><div class="v">@rb.GamesCompleted.ToString("N0")</div><div class="l">@L.T("cmp.kpi_b", resB!.Config.Players)</div></div>
    </div>
    @if (resA!.Config.Players != resB!.Config.Players || resA.Config.Seed != resB.Config.Seed)
    {
        <div class="error">@L.T("cmp.warn", L.T(resA.Config.Players != resB.Config.Players ? "cmp.diff.players" : "cmp.diff.seed"))</div>
    }

    <h2>@L.T("res.th.win")</h2>
    <figure class="chartbox">
        <BarChart Title="@L.T("cmp.chart")" LabelWidth="260" Format="@(v => v.ToString("P1"))"
                  Items="@(rows.SelectMany(r => Bars(r)).ToList())" />
    </figure>

    <h2>@L.T("res.h.data")</h2>
    <div class="tablewrap">
        <table class="data">
            <thead><tr><th>@L.T("res.th.strategy")</th><th>@L.T("cmp.th.a_win")</th><th>@L.T("cmp.th.b_win")</th><th>@L.T("cmp.th.diff")</th><th>±95%</th><th>@L.T("cmp.th.sig")</th><th>@L.T("cmp.th.a_avg")</th><th>@L.T("cmp.th.b_avg")</th><th>@L.T("cmp.th.score_diff")</th></tr></thead>
            <tbody>
            @foreach (var r in rows)
            {
                <tr>
                    <td>@Palette.DisplayName(r.Strategy)</td>
                    <td>@(r.A == null ? "—" : Pct(r.A.WinShare))</td>
                    <td>@(r.B == null ? "—" : Pct(r.B.WinShare))</td>
                    <td>@(r.HasBoth ? Signed(r.DeltaWin) : "—")</td>
                    <td>@(r.HasBoth ? Pct(r.DeltaWinCi95) : "—")</td>
                    <td>@(r.HasBoth ? (r.Significant ? L.T("cmp.yes") : L.T("cmp.no")) : "—")</td>
                    <td>@(r.A == null ? "—" : r.A.AvgScore.ToString("0.0"))</td>
                    <td>@(r.B == null ? "—" : r.B.AvgScore.ToString("0.0"))</td>
                    <td>@(r.HasBoth ? r.DeltaScore.ToString("+0.0;−0.0;0.0") : "—")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

@code {
    private string dir = "";
    private List<string> files = new();
    private string pathA = "", pathB = "";
    private bool loading;
    private string? error;
    private SimulationResult? resA, resB;
    private ResultAnalysis? ra, rb;
    private List<ComparisonRow>? rows;

    private sealed record Snap(List<string> Files, string PathA, string PathB, string? Error, SimulationResult? ResA, SimulationResult? ResB,
        ResultAnalysis? Ra, ResultAnalysis? Rb, List<ComparisonRow>? Rows);

    protected override void OnInitialized()
    {
        dir = AppState.ResultsDirectory(Config);
        if (Memory.Get<Snap>("compare") is { } m)
        {
            files = m.Files; pathA = m.PathA; pathB = m.PathB; error = m.Error; resA = m.ResA; resB = m.ResB; ra = m.Ra; rb = m.Rb; rows = m.Rows;
            return;
        }
        Refresh();
    }

    public void Dispose() => Memory.Set("compare", new Snap(files, pathA, pathB, error, resA, resB, ra, rb, rows));

    private void Refresh() =>
        files = ResultFiles.List(dir);

    private async Task Load()
    {
        loading = true; error = null; rows = null; StateHasChanged();
        try
        {
            (resA, ra) = await AppState.ReadResultAsync(pathA);
            (resB, rb) = await AppState.ReadResultAsync(pathB);
            rows = ResultComparison.Compare(ra!, rb!);
        }
        catch (Exception e) when (e is System.Text.Json.JsonException or InvalidDataException or LocException or IOException)
        {
            error = AppState.Scrub(L.Describe(e));
        }
        loading = false;
    }

    private IEnumerable<BarChart.BarItem> Bars(ComparisonRow r)
    {
        string name = Palette.DisplayName(r.Strategy);
        string color = Palette.Color(r.Strategy, 0);
        if (r.A != null)
            yield return new BarChart.BarItem(L.T("cmp.bar", name, "A"), r.A.WinShare, r.A.WinShareCi95, "var(--text-3)",
                L.T("cmp.tip", name, "A", r.A.WinShare.ToString("P1"), r.A.WinShareCi95.ToString("P1")));
        if (r.B != null)
            yield return new BarChart.BarItem(L.T("cmp.bar", name, "B"), r.B.WinShare, r.B.WinShareCi95, color,
                L.T("cmp.tip", name, "B", r.B.WinShare.ToString("P1"), r.B.WinShareCi95.ToString("P1")));
    }
}
