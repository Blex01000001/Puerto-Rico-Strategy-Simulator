@page "/sweep"
@implements IDisposable
@inject AppState State
@inject NavigationManager Nav

<PageTitle>@L.T("sw.page_title")</PageTitle>
<h1>@L.T("nav.sweep")</h1>
<p class="note">@((MarkupString)L.T("sw.intro"))</p>

<FilePicker>
    @if (State.Sweep != null && State.Result == null)
    {
        <button @onclick="SimulateAgain" title="@L.T("sw.again_title")">@L.T("sw.again")</button>
    }
</FilePicker>

@if (State.Result != null)
{
    <div class="ok">@L.T("sw.result_loaded")</div>
}
else if (State.Sweep != null)
{
    var sw = State.Sweep;
    var target = sw.Config.Seats.FirstOrDefault(s => s.Id == sw.Target);
    string color = Palette.Color(target?.Strategy ?? "", 0);
    var ordered = sw.Points.Select((p, i) => (p, i)).OrderByDescending(x => x.p.WinShare).ToList();
    var names = sw.Points.SelectMany(p => p.Params.Keys).Distinct().OrderBy(k => k, StringComparer.Ordinal).ToList();
    var best = sw.BestIndex >= 0 && sw.BestIndex < sw.Points.Count ? sw.Points[sw.BestIndex] : null;

    <div class="kpis">
        <div class="kpi"><div class="v">@sw.Points.Count / @sw.PointsPlanned</div><div class="l">@L.T("sw.kpi.points", sw.Status)</div></div>
        <div class="kpi"><div class="v">@Palette.Label(sw.Target, target?.Strategy ?? "")</div><div class="l">@L.T("sw.kpi.target")</div></div>
        <div class="kpi"><div class="v">@(sw.Points.Count == 0 ? 0 : sw.Points[0].Games.ToString("N0"))</div><div class="l">@L.T("sw.kpi.games")</div></div>
        <div class="kpi"><div class="v">@sw.Config.Players</div><div class="l">@L.T("res.kpi.players")</div></div>
        @if (best != null)
        {
            <div class="kpi"><div><div class="v">@best.WinShare.ToString("P1")</div><div class="sub">@Describe(best)</div></div><div class="l">@L.T("sw.kpi.best")</div></div>
        }
    </div>

    <h2>@L.T("sw.h.points")</h2>
    <p class="note">@L.T("sw.points_note")</p>
    <figure class="chartbox">
        <BarChart Title="@L.T("sw.h.points")" LabelWidth="260" Format="@(v => v.ToString("P1"))"
                  Items="@(ordered.Take(40).Select(x => new BarChart.BarItem(Describe(x.p), x.p.WinShare, x.p.WinShareCi95, color,
                       L.T("sw.tip", Describe(x.p), x.p.WinShare.ToString("P1"), x.p.WinShareCi95.ToString("P1"), x.p.AvgScore.ToString("0.0")))).ToList())" />
    </figure>
    @if (ordered.Count > 40) { <p class="note">@L.T("sw.first40")</p> }

    @if (names.Count == 2)
    {
        string rowName = names[0], colName = names[1];
        var rowVals = sw.Points.Select(p => p.Params[rowName]).Distinct().OrderBy(v => v).ToList();
        var colVals = sw.Points.Select(p => p.Params[colName]).Distinct().OrderBy(v => v).ToList();
        double lo = sw.Points.Min(p => p.WinShare), hi = sw.Points.Max(p => p.WinShare);
        <h2>@L.T("sw.h.heat")</h2>
        <p class="note">@L.T("sw.heat_note", rowName, colName)</p>
        <div class="tablewrap">
            <table class="data heat">
                <thead><tr><th>@rowName \ @colName</th>@foreach (var c in colVals) { <th>@c.ToString("0.##")</th> }</tr></thead>
                <tbody>
                @foreach (var rv in rowVals)
                {
                    <tr>
                        <td>@rv.ToString("0.##")</td>
                        @foreach (var cv in colVals)
                        {
                            var p = sw.Points.FirstOrDefault(q => q.Params[rowName] == rv && q.Params[colName] == cv);
                            double t = p == null || hi <= lo ? 0 : (p.WinShare - lo) / (hi - lo);
                            <td class="cell" style="@HeatStyle(t)">@(p == null ? "—" : p.WinShare.ToString("P1"))</td>
                        }
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }

    <h2>@L.T("res.h.data")</h2>
    <details open>
        <summary>@L.T("sw.all_points")</summary>
        <div class="tablewrap">
            <table class="data">
                <thead><tr><th>@L.T("sw.th.params")</th><th>@L.T("res.th.games")</th><th>@L.T("res.th.win")</th><th>±95%</th><th>@L.T("res.th.avg")</th><th>@L.T("res.th.std")</th></tr></thead>
                <tbody>
                @foreach (var x in ordered)
                {
                    <tr>
                        <td>@Describe(x.p)</td><td>@x.p.Games.ToString("N0")</td><td>@x.p.WinShare.ToString("P1")</td>
                        <td>@x.p.WinShareCi95.ToString("P1")</td><td>@x.p.AvgScore.ToString("0.0")</td><td>@x.p.StdScore.ToString("0.0")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </details>
}

@code {
    protected override void OnInitialized() => State.Changed += OnChanged;
    private void OnChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => State.Changed -= OnChanged;

    private void SimulateAgain()
    {
        if (State.Sweep == null) return;
        State.SetTemplate(State.Sweep.Config, State.Source ?? L.T("sw.current"));
        Nav.NavigateTo("simulate");
    }

    private static string Describe(SweepPoint p) => SweepRunner.Describe(p.Params);

    private static string HeatStyle(double t) =>
        FormattableString.Invariant($"background:color-mix(in srgb, var(--series-1) {Math.Clamp(t, 0, 1) * 80:0}%, var(--neutral))");
}
