@page "/replay"
@using PuertoRico.Engine.Events
@using PuertoRico.Engine.Game
@implements IDisposable
@inject IConfiguration Config
@inject PageMemory Memory

<PageTitle>@L.T("rp.page_title")</PageTitle>
<h1>@L.T("nav.replay")</h1>
<p class="note">@L.T("rp.intro")</p>

<div class="panel">
    <div class="row">
        <label>@L.T("fp.label")
            <select @bind="path"><option value="">(@L.T("fp.choose"))</option>@foreach (var f in files) { <option value="@f">@ResultFiles.Label(dir, f)</option> }</select>
        </label>
        <label>@L.T("rp.game_no")<input type="number" min="0" @bind="index" /></label>
        <button @onclick="Run" disabled="@(string.IsNullOrEmpty(path) || loading)">@L.T("rp.run")</button>
        <button class="secondary" @onclick="Refresh">@L.T("sim.refresh")</button>
        <span class="note">@(cfg == null ? "" : L.T("rp.cfg_line", cfg.Players, cfg.Games.ToString("N0"), cfg.Seed, Palette.SeatOrderLabel(cfg.SeatOrder, L)))</span>
    </div>
    @if (loading) { <p>@L.T("rp.loading")</p> }
    @if (error != null) { <div class="error">@error</div> }
</div>

@if (record != null && cfg != null)
{
    <div class="kpis">
        <div class="kpi"><div class="v">@record.Rounds</div><div class="l">@L.T("rp.kpi.rounds")</div></div>
        <div class="kpi"><div class="v">@record.Decisions</div><div class="l">@L.T("rp.kpi.decisions")</div></div>
        <div class="kpi"><div class="v">@L.EndReason(record.EndReason)</div><div class="l">@L.T("rp.kpi.reason")</div></div>
        <div class="kpi"><div class="v">@string.Join(L.T("common.list"), record.Winners.Select(w => SeatName(w)))</div><div class="l">@L.T("rp.kpi.winner")</div></div>
    </div>

    <h2>@L.T("rp.h.players")</h2>
    <div class="tablewrap">
        <table class="data">
            <thead><tr><th>@L.T("rp.th.seat")</th><th>@L.T("rp.th.strategy")</th><th>@L.T("rp.th.rank")</th><th>@L.T("rp.th.total")</th><th>@L.T("rp.th.chips")</th><th>@L.T("rp.th.bld")</th><th>@L.T("rp.th.bonus")</th><th>@L.T("rp.th.coins")</th><th>@L.T("rp.th.shipments")</th><th class="left">@L.T("rp.th.buildings")</th></tr></thead>
            <tbody>
            @foreach (var p in record.Players.OrderBy(p => p.Rank))
            {
                <tr>
                    <td>@(p.Seat + 1)</td><td>@SeatName(p.Seat)</td><td>@p.Rank</td><td>@p.Vp</td><td>@p.Chips</td><td>@p.BuildingPoints</td><td>@p.BonusPoints</td><td>@p.Coins</td><td>@p.Shipments</td>
                    <td class="left">@(p.Buildings == null ? "—" : string.Join(L.T("common.list"), p.Buildings.Select((b, i) => L.T("rp.bld_item", Buildings.All[b].Name, p.BuiltRounds![i]))))</td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <h2>@L.T("rp.h.board")</h2>
    <p class="note">@L.T("rp.board_note", step)</p>
    <div class="stepdock">
    <div class="stepbar">
        <button class="secondary" @onclick="@(() => Go(0))" disabled="@(step == 0)">@L.T("rp.first")</button>
        <button class="secondary" id="replay-prev" title="@L.T("rp.key_left")" @onclick="@(() => Go(step - 1))" disabled="@(step == 0)">@L.T("rp.prev")</button>
        <input type="range" min="0" max="@events.Count" value="@step" @oninput="@(e => Go(int.Parse(e.Value?.ToString() ?? "0")))" />
        <button class="secondary" id="replay-next" title="@L.T("rp.key_right")" @onclick="@(() => Go(step + 1))" disabled="@(step >= events.Count)">@L.T("rp.next")</button>
        <button class="secondary" @onclick="@(() => Go(events.Count))" disabled="@(step >= events.Count)">@L.T("rp.last")</button>
        <span>@L.T("rp.step_prefix")<input type="number" min="0" max="@events.Count" value="@step" @onchange="@(e => Go(int.TryParse(e.Value?.ToString(), out var v) ? v : step))" style="width:5.5rem" />@L.T("rp.step_suffix", events.Count)</span>
    </div>
    <div class="panel">
        @if (step < events.Count)
        {
            var ev = events[step];
            <span>@L.T("rp.line", ev.Round, PhaseLabel(ev.Phase), ev.Seat + 1, SeatNameFn(ev.Seat))<strong>@ActionText.Describe(L, snaps[step], ParseAction(step))</strong> <span class="muted">（@ev.Action）</span></span>
        }
        else { <span>@L.T("rp.final")</span> }
    </div>
    </div>
    <BoardView S="@(step < events.Count ? snaps[step] : finalState!)" SeatNameOf="@((Func<int, string>)SeatNameFn)" />
    @if (step < events.Count)
    {
        <div class="panel">
            @if (searches[step] is { } sr)
            {
                <MctsSearch Search="sr" Actions="@ActionText.DescribeAll(L, snaps[step], sr)" Chosen="@actions[step]" />
            }
            else
            {
                <LegalActions State="snaps[step]" SeatName="@SeatNameFn(events[step].Seat)" Chosen="@actions[step]" Scores="scores[step]" />
            }
        </div>
    }

    <h2>@L.T("rp.h.log", shown.Count, events.Count)</h2>
    <div class="panel">
        <div class="row">
            <label>@L.T("rp.seat")
                <select @bind="seatFilter">
                    <option value="-1">@L.T("ov.all")</option>
                    @foreach (var p in record.Players) { <option value="@p.Seat">@(p.Seat + 1) · @SeatName(p.Seat)</option> }
                </select>
            </label>
            <label>@L.T("rp.round") <input type="number" min="0" max="@record.Rounds" @bind="roundFilter" /> @L.T("rp.round_all")</label>
            <label>@L.T("rp.action_has") <input type="text" @bind="textFilter" @bind:event="oninput" placeholder="@L.T("rp.action_ph")" /></label>
        </div>
    </div>
    <div class="tablewrap">
        <table class="data">
            <thead><tr><th>#</th><th>@L.T("rp.th.round")</th><th>@L.T("rp.th.phase")</th><th>@L.T("rp.th.seat")</th><th>@L.T("rp.th.strategy")</th><th class="left">@L.T("rp.th.desc")</th><th class="left">@L.T("rp.th.raw")</th></tr></thead>
            <tbody>
            @foreach (var (e, i) in shown.Take(1500))
            {
                <tr class="clickable @(i == step ? "cur" : "")" @onclick="@(() => Go(i))" title="@L.T("rp.row_title")"><td>@i</td><td>@e.Round</td><td>@e.Phase</td><td>@(e.Seat + 1)</td><td>@SeatName(e.Seat)</td><td class="left">@ActionText.Describe(L, snaps[i], actions[i])@(searches[i] != null ? " 🔍" : "")</td><td class="left muted">@e.Action</td></tr>
            }
            </tbody>
        </table>
    </div>
    @if (shown.Count > 1500) { <p class="note">@L.T("rp.only_first")</p> }
}

@code {
    private string dir = "";
    private List<string> files = new();
    private string path = "";
    private int index;
    private bool loading;
    private string? error;
    private SimulationConfig? cfg;
    private GameRecord? record;
    private List<GameEvent> events = new();
    private List<GameState> snaps = new();
    private List<GameAction> actions = new();
    private List<PuertoRico.Engine.Strategies.SearchSummary?> searches = new();
    private List<IReadOnlyList<PuertoRico.Engine.Strategies.ScoredAction>?> scores = new();
    private GameState? finalState;
    private int step;
    private string SeatNameFn(int seat) => record == null || cfg == null ? "" : Palette.DisplayName(cfg.Seats.First(s => s.Id == record.Players.First(p => p.Seat == seat).SeatId).Strategy);
    private string SeatName(int seat) => SeatNameFn(seat);
    private GameAction ParseAction(int i) => actions[i];
    private string PhaseLabel(Phase p) => p switch
    {
        Phase.ChooseRole or Phase.Settler or Phase.Mayor or Phase.Builder or Phase.CraftsmanBonus or Phase.Trader or Phase.Captain or Phase.CaptainStorage => L.T("phase." + p),
        _ => p.ToString(),
    };
    private void Go(int s) => step = Math.Clamp(s, 0, events.Count);
    private int seatFilter = -1, roundFilter;
    private string textFilter = "";

    private List<(GameEvent E, int I)> shown => events.Select((e, i) => (e, i))
        .Where(x => (seatFilter < 0 || x.e.Seat == seatFilter) && (roundFilter <= 0 || x.e.Round == roundFilter)
                    && (string.IsNullOrWhiteSpace(textFilter) || x.e.Action.Contains(textFilter.Trim(), StringComparison.OrdinalIgnoreCase))).ToList();

    /// <summary>Deep link from the game list: <c>replay?file=NAME.json&amp;game=N</c> opens and replays that game.</summary>
    [SupplyParameterFromQuery(Name = "file")] public string? FileParam { get; set; }
    [SupplyParameterFromQuery(Name = "game")] public int? GameParam { get; set; }

    private sealed record Snap(List<string> Files, string Path, int Index, string? Error, SimulationConfig? Cfg, GameRecord? Record, List<GameEvent> Events,
        List<GameState> Snaps, List<GameAction> Actions, List<PuertoRico.Engine.Strategies.SearchSummary?> Searches, List<IReadOnlyList<PuertoRico.Engine.Strategies.ScoredAction>?> Scores, GameState? FinalState, int Step,
        int SeatFilter, int RoundFilter, string TextFilter);

    protected override async Task OnInitializedAsync()
    {
        dir = AppState.ResultsDirectory(Config);
        bool deepLink = !string.IsNullOrEmpty(FileParam) && GameParam is int;
        // coming back from another page without a link: the game is still there, at the same step (it is not replayed again)
        if (!deepLink && Memory.Get<Snap>("replay") is { } m)
        {
            files = m.Files; path = m.Path; index = m.Index; error = m.Error; cfg = m.Cfg; record = m.Record; events = m.Events; snaps = m.Snaps;
            actions = m.Actions; searches = m.Searches; scores = m.Scores; finalState = m.FinalState; step = m.Step; seatFilter = m.SeatFilter; roundFilter = m.RoundFilter; textFilter = m.TextFilter;
            return;
        }
        Refresh();
        if (deepLink)
        {
            var match = files.FirstOrDefault(f => string.Equals(Path.GetFileName(f), FileParam, StringComparison.OrdinalIgnoreCase));
            if (match != null) { path = match; index = GameParam!.Value; await Run(); }
        }
    }

    public void Dispose()
    {
        if (loading) { Memory.Forget("replay"); return; } // left while the game was being replayed: nothing complete to remember
        Memory.Set("replay", new Snap(files, path, index, error, cfg, record, events, snaps, actions, searches, scores, finalState, step, seatFilter, roundFilter, textFilter));
    }

    private void Refresh() =>
        files = ResultFiles.List(dir);

    private async Task Run()
    {
        loading = true; error = null; record = null; StateHasChanged();
        try
        {
            cfg = await AppState.ReadConfigAsync(path);
            if (index < 0 || index >= cfg.Games) throw new LocException("rp.err.index", cfg.Games - 1);
            var sink = new SnapshotEventSink();
            GameState end = null!;
            record = await Task.Run(() => GameRunner.Play(cfg, index, sink, out end));
            events = sink.Events; snaps = sink.Before; actions = sink.Actions; searches = sink.Searches; scores = sink.Scores; finalState = end; step = 0;
            seatFilter = -1; roundFilter = 0; textFilter = "";
        }
        catch (Exception e) when (e is System.Text.Json.JsonException or InvalidDataException or LocException or IOException)
        {
            error = AppState.Scrub(L.Describe(e));
        }
        loading = false;
    }
}
