@page "/replay"
@using PuertoRico.Engine.Events
@using PuertoRico.Engine.Game
@inject IConfiguration Config

<PageTitle>模擬重播 · 波多黎各策略模擬器</PageTitle>
<h1>模擬重播</h1>
<p class="note">從結果檔取出設定與種子，重新打指定的那一局並列出每個決策（同一份設定與局號一定重現同一局，也不需要結果檔含逐局記錄）。需要用同版本的引擎產生的結果檔才會與原結果一致。</p>

<div class="panel">
    <div class="row">
        <label>結果檔
            <select @bind="path"><option value="">（選擇檔案）</option>@foreach (var f in files) { <option value="@f">@Path.GetFileName(f)</option> }</select>
        </label>
        <label>局號（0 起算）<input type="number" min="0" @bind="index" /></label>
        <button @onclick="Run" disabled="@(string.IsNullOrEmpty(path) || loading)">回放</button>
        <button class="secondary" @onclick="Refresh">重新整理</button>
        <span class="note">@(cfg == null ? "" : $"{cfg.Players} 人局 · {cfg.Games:N0} 局 · 主種子 {cfg.Seed} · {Palette.SeatOrderLabel(cfg.SeatOrder)}")</span>
    </div>
    @if (loading) { <p>讀取並重打中…</p> }
    @if (error != null) { <div class="error">@error</div> }
</div>

@if (record != null && cfg != null)
{
    <div class="kpis">
        <div class="kpi"><div class="v">@record.Rounds</div><div class="l">回合數</div></div>
        <div class="kpi"><div class="v">@record.Decisions</div><div class="l">決策數</div></div>
        <div class="kpi"><div class="v">@record.EndReason</div><div class="l">終局原因</div></div>
        <div class="kpi"><div class="v">@string.Join("、", record.Winners.Select(w => SeatName(w)))</div><div class="l">贏家</div></div>
    </div>

    <h2>各玩家結果</h2>
    <div class="tablewrap">
        <table class="data">
            <thead><tr><th>桌位</th><th>策略</th><th>名次</th><th>總分</th><th>出貨籌碼</th><th>建築分</th><th>大型建築加成</th><th>金幣</th><th>出貨次數</th><th class="left">建築（購買回合）</th></tr></thead>
            <tbody>
            @foreach (var p in record.Players.OrderBy(p => p.Rank))
            {
                <tr>
                    <td>@(p.Seat + 1)</td><td>@SeatName(p.Seat)</td><td>@p.Rank</td><td>@p.Vp</td><td>@p.Chips</td><td>@p.BuildingPoints</td><td>@p.BonusPoints</td><td>@p.Coins</td><td>@p.Shipments</td>
                    <td class="left">@(p.Buildings == null ? "—" : string.Join("、", p.Buildings.Select((b, i) => $"{Buildings.All[b].Name}（{p.BuiltRounds![i]}）")))</td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <h2>盤面</h2>
    <p class="note">顯示「第 @step 個決策之前」的盤面（輪到的玩家以藍框標示）；拉到最右邊是終局盤面。種植園方塊裡的 ● 代表有殖民者，建築名稱下的 ●○ 是殖民者／空位。</p>
    <div class="stepbar">
        <button class="secondary" @onclick="@(() => Go(0))" disabled="@(step == 0)">⏮ 開頭</button>
        <button class="secondary" @onclick="@(() => Go(step - 1))" disabled="@(step == 0)">◀ 上一步</button>
        <input type="range" min="0" max="@events.Count" value="@step" @oninput="@(e => Go(int.Parse(e.Value?.ToString() ?? "0")))" />
        <button class="secondary" @onclick="@(() => Go(step + 1))" disabled="@(step >= events.Count)">下一步 ▶</button>
        <button class="secondary" @onclick="@(() => Go(events.Count))" disabled="@(step >= events.Count)">⏭ 終局</button>
        <span>第 <input type="number" min="0" max="@events.Count" value="@step" @onchange="@(e => Go(int.TryParse(e.Value?.ToString(), out var v) ? v : step))" style="width:5.5rem" /> / @events.Count 步</span>
    </div>
    <div class="panel">
        @if (step < events.Count)
        {
            var ev = events[step];
            <span>第 @ev.Round 回合 · @PhaseLabel(ev.Phase) · 座位 @(ev.Seat + 1)（@SeatNameFn(ev.Seat)）：<strong>@ActionText.Describe(snaps[step], ParseAction(step))</strong> <span class="muted">（@ev.Action）</span></span>
            @if (searches[step] is { } sr) { <MctsSearch Search="sr" Actions="@ActionText.DescribeAll(snaps[step], sr)" Chosen="@actions[step]" /> }
        }
        else { <span>終局盤面（所有決策已執行完）。</span> }
    </div>
    <BoardView S="@(step < events.Count ? snaps[step] : finalState!)" SeatNameOf="@((Func<int, string>)SeatNameFn)" />

    <h2>決策記錄（@shown.Count / @events.Count）</h2>
    <div class="panel">
        <div class="row">
            <label>桌位
                <select @bind="seatFilter">
                    <option value="-1">全部</option>
                    @foreach (var p in record.Players) { <option value="@p.Seat">@(p.Seat + 1) · @SeatName(p.Seat)</option> }
                </select>
            </label>
            <label>回合 <input type="number" min="0" max="@record.Rounds" @bind="roundFilter" /> （0 = 全部）</label>
            <label>動作含 <input type="text" @bind="textFilter" @bind:event="oninput" placeholder="例如 Build、LoadShip" /></label>
        </div>
    </div>
    <div class="tablewrap">
        <table class="data">
            <thead><tr><th>#</th><th>回合</th><th>階段</th><th>桌位</th><th>策略</th><th class="left">動作說明</th><th class="left">原始動作</th></tr></thead>
            <tbody>
            @foreach (var (e, i) in shown.Take(1500))
            {
                <tr class="clickable @(i == step ? "cur" : "")" @onclick="@(() => Go(i))" title="點一下，在上面的盤面看這一步之前的局面"><td>@i</td><td>@e.Round</td><td>@e.Phase</td><td>@(e.Seat + 1)</td><td>@SeatName(e.Seat)</td><td class="left">@ActionText.Describe(snaps[i], actions[i])@(searches[i] != null ? " 🔍" : "")</td><td class="left muted">@e.Action</td></tr>
            }
            </tbody>
        </table>
    </div>
    @if (shown.Count > 1500) { <p class="note">只顯示前 1500 筆，請用上方篩選縮小範圍。</p> }
}

@code {
    private string dir = "";
    private List<string> files = new();
    private string path = "";
    private int index;
    private bool loading;
    private string? error;
    private SimulationConfig? cfg;
    private GameRecord? record;
    private List<GameEvent> events = new();
    private List<GameState> snaps = new();
    private List<GameAction> actions = new();
    private List<PuertoRico.Engine.Strategies.SearchSummary?> searches = new();
    private GameState? finalState;
    private int step;
    private string SeatNameFn(int seat) => record == null || cfg == null ? "" : Palette.DisplayName(cfg.Seats.First(s => s.Id == record.Players.First(p => p.Seat == seat).SeatId).Strategy);
    private string SeatName(int seat) => SeatNameFn(seat);
    private GameAction ParseAction(int i) => actions[i];
    private static string PhaseLabel(Phase p) => p switch
    {
        Phase.ChooseRole => "選職業", Phase.Settler => "開拓者", Phase.Mayor => "市長", Phase.Builder => "建築師",
        Phase.CraftsmanBonus => "工匠", Phase.Trader => "商人", Phase.Captain => "船長", Phase.CaptainStorage => "船長（保留貨物）", _ => p.ToString(),
    };
    private void Go(int s) => step = Math.Clamp(s, 0, events.Count);
    private int seatFilter = -1, roundFilter;
    private string textFilter = "";

    private List<(GameEvent E, int I)> shown => events.Select((e, i) => (e, i))
        .Where(x => (seatFilter < 0 || x.e.Seat == seatFilter) && (roundFilter <= 0 || x.e.Round == roundFilter)
                    && (string.IsNullOrWhiteSpace(textFilter) || x.e.Action.Contains(textFilter.Trim(), StringComparison.OrdinalIgnoreCase))).ToList();

    /// <summary>Deep link from the game list: <c>replay?file=NAME.json&amp;game=N</c> opens and replays that game.</summary>
    [SupplyParameterFromQuery(Name = "file")] public string? FileParam { get; set; }
    [SupplyParameterFromQuery(Name = "game")] public int? GameParam { get; set; }

    protected override async Task OnInitializedAsync()
    {
        dir = AppState.ResultsDirectory(Config);
        Refresh();
        if (!string.IsNullOrEmpty(FileParam) && GameParam is int g)
        {
            var match = files.FirstOrDefault(f => string.Equals(Path.GetFileName(f), FileParam, StringComparison.OrdinalIgnoreCase));
            if (match != null) { path = match; index = g; await Run(); }
        }
    }

    private void Refresh() =>
        files = Directory.Exists(dir)
            ? Directory.GetFiles(dir, "*.json").Where(f => !f.EndsWith(".tmp")).OrderBy(f => f, StringComparer.OrdinalIgnoreCase).ToList()
            : new List<string>();

    private async Task Run()
    {
        loading = true; error = null; record = null; StateHasChanged();
        try
        {
            cfg = await AppState.ReadConfigAsync(path);
            if (index < 0 || index >= cfg.Games) throw new InvalidDataException($"局號要在 0～{cfg.Games - 1} 之間");
            var sink = new SnapshotEventSink();
            GameState end = null!;
            record = await Task.Run(() => GameRunner.Play(cfg, index, sink, out end));
            events = sink.Events; snaps = sink.Before; actions = sink.Actions; searches = sink.Searches; finalState = end; step = 0;
            seatFilter = -1; roundFilter = 0; textFilter = "";
        }
        catch (Exception e) when (e is System.Text.Json.JsonException or InvalidDataException or IOException)
        {
            error = AppState.Scrub(e.Message);
        }
        loading = false;
    }
}
