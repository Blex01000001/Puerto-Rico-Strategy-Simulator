@page "/config"
@using System.Text.Json
@implements IDisposable
@inject AppState State
@inject PageMemory Memory

<PageTitle>@L.T("cf.page_title")</PageTitle>
<h1>@L.T("nav.config")</h1>
<p class="note">@L.T("cf.intro")</p>

<div class="panel">
    <div class="row">
        <button class="secondary" @onclick="@(() => Set(Template(3)))">@L.T("cf.p3")</button>
        <button class="secondary" @onclick="@(() => Set(Template(4)))">@L.T("cf.p4")</button>
        <button class="secondary" @onclick="UseLoaded" disabled="@(State.Result == null)">@L.T("cf.use_loaded")</button>
        <span class="muted">@L.T("cf.strategies", string.Join(L.T("common.list"), KnownStrategies))</span>
    </div>
</div>

<textarea spellcheck="false" @bind="text" @bind:event="oninput"></textarea>

<div class="row" style="margin-top:.6rem">
    <button @onclick="Validate">@L.T("cf.validate")</button>
    <a class="btn secondary" href="data:application/json;charset=utf-8,@Uri.EscapeDataString(text)" download="config.json">@L.T("cf.download")</a>
</div>

@if (error != null) { <div class="error">@error</div> }
@if (message != null) { <div class="ok">@message</div> }

<h2>@L.T("cf.h.run")</h2>
<pre class="panel"><code>dotnet run -c Release --project Runner -- --config config.json --out results/result.json
dotnet run -c Release --project Runner -- --config config.json --sweep --out results/sweep.json   # @L.T("cf.run_comment")</code></pre>

@code {
    private static readonly string[] KnownStrategies = { "random", "corn-shipper", "corn-to-premium", "harbor-rush", "build-first", "rule-based" };
    private string text = "";
    private string? error;
    private string? message;

    protected override void OnInitialized()
    {
        State.Changed += OnChanged;
        if (Memory.Get<Snap>("config") is { } m) { text = m.Text; error = m.Error; message = m.Message; return; }
        text = Template(3);
    }

    private sealed record Snap(string Text, string? Error, string? Message);

    private void OnChanged() => InvokeAsync(StateHasChanged);
    public void Dispose()
    {
        State.Changed -= OnChanged;
        Memory.Set("config", new Snap(text, error, message));
    }

    private void Set(string json) { text = json; error = null; message = null; }

    private void UseLoaded()
    {
        if (State.Result != null) Set(JsonSerializer.Serialize(State.Result.Config, Pretty));
    }

    private static readonly JsonSerializerOptions Pretty = new(SimulationConfig.JsonOptions) { WriteIndented = true };

    private static string Template(int players)
    {
        var cfg = new SimulationConfig
        {
            Name = $"{players}p-comparison", Players = players, Games = 100000, Seed = 12345,
            Seats = new[] { ("corn", "corn-shipper"), ("premium", "corn-to-premium"), ("harbor", "harbor-rush"), ("build", "build-first") }
                .Take(players).Select(s => new SeatConfig { Id = s.Item1, Strategy = s.Item2 }).ToList(),
        };
        return JsonSerializer.Serialize(cfg, Pretty);
    }

    private void Validate()
    {
        error = message = null;
        try
        {
            var cfg = JsonSerializer.Deserialize<SimulationConfig>(text, SimulationConfig.JsonOptions)
                      ?? throw new LocException("err.empty_config");
            cfg.Validate();
            message = L.T("cf.valid", cfg.Players, cfg.Games.ToString("N0"), Palette.SeatOrderLabel(cfg.SeatOrder, L), string.Join(L.T("common.list"), cfg.Seats.Select(s => $"{s.Id}={s.Strategy}"))) + (cfg.Sweep != null ? L.T("cf.sweep_block") : "");
        }
        catch (Exception e) when (e is JsonException or InvalidDataException or LocException)
        {
            error = L.Describe(e);
        }
    }
}
