@page "/versions"
@using PuertoRico.Engine.Game
@using PuertoRico.Engine.Strategies
@using Dashboard.Services

<PageTitle>版本控管 · 波多黎各策略模擬器</PageTitle>
<h1>版本控管</h1>
<p class="note">規則版本、引擎版本、策略版本等各種版本號碼，以及每個版本做了哪些修改。資料來源是 docs/versions.json（和 ML UI 同一份）。</p>

<div class="panel">
    <strong>這個 Dashboard 使用的引擎</strong>
    <div class="row" style="margin-top:.4rem">
        <span class="muted">規則版本</span> <strong>@(EngineInfo.RulesVersion)-v@(EngineInfo.RulesRevision)</strong>
        <span class="muted">引擎版本</span> <strong>@EngineInfo.Version</strong>
        <span class="muted">git commit</span> <strong>@EngineInfo.Commit</strong>
    </div>
    <p class="note">規則版本只管遊戲規則與亂數，每個策略另有自己的策略版本；這兩種版本號和完整參數一起決定 ML 工具的 hash，用來判斷資料與模型是不是舊的。引擎版本給人看，commit 只用來追溯（不進 hash）；結果檔的 engineCommit 帶「-dirty」表示當時有未提交的修改。</p>
</div>

@if (error != null) { <div class="error">@error</div> }

@foreach (var t in tracks.Where(t => !t.Id.StartsWith("strategy:")))
{
    <h2>@t.Title</h2>
    <div class="panel">
        <p class="note"><strong>目前：@t.Show(t.Current?.Version ?? "?")</strong>・來源：<code>@t.Source</code></p>
        <p class="note">@t.Meaning</p>
        <p class="note"><strong>什麼時候加：</strong>@t.Bump</p>
        <table class="data">
            <thead><tr><th>版本</th><th>日期</th><th>commit</th><th style="text-align:left">修改內容</th></tr></thead>
            <tbody>
            @foreach (var e in t.Entries)
            {
                <tr>
                    <td>@t.Show(e.Version)</td>
                    <td>@e.Date</td>
                    <td><code>@(e.Commit.Length >= 8 ? e.Commit[..8] : "—")</code></td>
                    <td style="text-align:left; white-space:normal"><ul style="margin:0; padding-left:1.1rem">@foreach (var c in e.Changes) { <li>@c</li> }</ul></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

@{ var strategies = tracks.Where(t => t.Id.StartsWith("strategy:")).ToList(); }
@if (strategies.Count > 0)
{
    <h2>策略版本</h2>
    <div class="panel">
        <p class="note">@strategies[0].Meaning</p>
        <p class="note"><strong>什麼時候加：</strong>@strategies[0].Bump</p>
        <table class="data">
            <thead><tr><th>策略</th><th>目前版本</th><th>程式裡</th><th>日期</th><th>commit</th><th style="text-align:left">這個版本的修改</th></tr></thead>
            <tbody>
            @foreach (var t in strategies)
            {
                var e = t.Current;
                int? code = StrategyRegistry.Revisions.TryGetValue(t.Title, out var r) ? r : null;
                <tr>
                    <td>@t.Title</td>
                    <td>@t.Show(e?.Version ?? "?")</td>
                    <td style="@(code?.ToString() == e?.Version ? "" : "color:var(--neg)")">@(code is { } c ? $"v{c}" : "—")</td>
                    <td>@e?.Date</td>
                    <td><code>@(e != null && e.Commit.Length >= 8 ? e.Commit[..8] : "—")</code></td>
                    <td style="text-align:left; white-space:normal">@string.Join("；", e?.Changes ?? Array.Empty<string>())</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

@code {
    private List<VersionLog.Track> tracks = new();
    private string? error;

    protected override void OnInitialized() => (tracks, error) = VersionLog.Load();
}
