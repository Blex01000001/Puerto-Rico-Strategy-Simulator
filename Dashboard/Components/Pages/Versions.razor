@page "/versions"
@using PuertoRico.Engine.Game
@using PuertoRico.Engine.Strategies
@using PuertoRico.Engine.Strategies.Mcts
@using PuertoRico.Engine.Simulation
@using Dashboard.Services

<PageTitle>@L.T("vs.page_title")</PageTitle>
<div class="vpage">
<h1>@L.T("nav.versions")</h1>
<p class="note">@L.T("vs.intro")</p>

<div class="panel">
    <strong>@L.T("vs.engine_box")</strong>
    @* same tiles as the ML UI's version page *@
    <div class="vtiles">
        <div class="vtile"><div class="l">@L.T("vs.rules")</div><div class="v">@(EngineInfo.RulesVersion)-v@(EngineInfo.RulesRevision)</div></div>
        <div class="vtile"><div class="l">@L.T("vs.engine")</div><div class="v">@EngineInfo.Version</div></div>
        <div class="vtile"><div class="l">@L.T("vs.features")</div><div class="v">@FeatureSets.LatestVersion</div></div>
        <div class="vtile"><div class="l">@L.T("vs.format")</div><div class="v">@PositionDump.FormatVersion</div></div>
        <div class="vtile wide"><div class="l">git commit</div><div class="v">@CommitId</div>@if (Dirty) { <div class="sub">@L.T("vs.dirty")</div> }</div>
    </div>
    <p class="note">@L.T("vs.note")</p>
</div>

@if (error != null) { <div class="error">@error</div> }

@foreach (var t in tracks.Where(t => !t.Id.StartsWith("strategy:")))
{
    <h2>@t.Title</h2>
    <div class="panel">
        <p class="note"><strong>@L.T("vs.current", t.Show(t.Current?.Version ?? "?"))</strong>・@L.T("vs.source")<code>@t.Source</code></p>
        <p class="note">@t.Meaning</p>
        <p class="note"><strong>@L.T("vs.bump")</strong>@t.Bump</p>
        <table class="data vtable">
            <thead><tr><th>@L.T("vs.th.version")</th><th>@L.T("vs.th.date")</th><th>commit</th><th>@L.T("vs.th.changes")</th></tr></thead>
            <tbody>
            @foreach (var e in t.Entries)
            {
                <tr>
                    <td class="c">@t.Show(e.Version)</td>
                    <td class="c">@e.Date</td>
                    <td class="c"><code>@(e.Commit.Length >= 8 ? e.Commit[..8] : "—")</code></td>
                    <td class="l"><ul>@foreach (var c in e.Changes) { <li>@c</li> }</ul></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

@{ var strategies = tracks.Where(t => t.Id.StartsWith("strategy:")).ToList(); }
@if (strategies.Count > 0)
{
    <h2>@L.T("vs.h.strategies")</h2>
    <div class="panel">
        <p class="note">@strategies[0].Meaning</p>
        <p class="note"><strong>@L.T("vs.bump")</strong>@strategies[0].Bump</p>
        <table class="data vtable">
            <thead><tr><th>@L.T("vs.th.strategy")</th><th>@L.T("vs.th.current")</th><th>@L.T("vs.th.code")</th><th>@L.T("vs.th.date")</th><th>commit</th><th>@L.T("vs.th.this")</th></tr></thead>
            <tbody>
            @foreach (var t in strategies)
            {
                var e = t.Current;
                int? code = StrategyRegistry.Revisions.TryGetValue(t.Title, out var r) ? r : null;
                <tr>
                    <td class="l nw">@t.Title</td>
                    <td class="c">@t.Show(e?.Version ?? "?")</td>
                    <td class="c" style="@(code?.ToString() == e?.Version ? "" : "color:var(--neg)")">@(code is { } rev ? $"v{rev}" : "—")</td>
                    <td class="c">@e?.Date</td>
                    <td class="c"><code>@(e != null && e.Commit.Length >= 8 ? e.Commit[..8] : "—")</code></td>
                    <td class="l"><ul>@foreach (var c in e?.Changes ?? Array.Empty<string>()) { <li>@c</li> }</ul></td>
                </tr>
            }
            </tbody>
        </table>
        <details style="margin-top:.6rem">
            <summary>@L.T("vs.history")</summary>
            <table class="data vtable">
                <thead><tr><th>@L.T("vs.th.version")</th><th>@L.T("vs.th.date")</th><th>commit</th><th>@L.T("vs.th.changes")</th></tr></thead>
                <tbody>
                @foreach (var t in strategies)
                {
                    foreach (var e in t.Entries)
                    {
                        <tr>
                            <td class="c">@t.Show(e.Version)</td>
                            <td class="c">@e.Date</td>
                            <td class="c"><code>@(e.Commit.Length >= 8 ? e.Commit[..8] : "—")</code></td>
                            <td class="l"><ul>@foreach (var c in e.Changes) { <li>@c</li> }</ul></td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </details>
    </div>
}

</div>

@code {
    // "a1b2c3d4-dirty": the commit as large as the other tiles, the dirty mark as a note under it
    private static bool Dirty => EngineInfo.Commit.EndsWith("-dirty", StringComparison.Ordinal);
    private static string CommitId => Dirty ? EngineInfo.Commit[..^"-dirty".Length] : EngineInfo.Commit;
    private List<VersionLog.Track> tracks = new();
    private string? error;

    protected override void OnInitialized() => (tracks, error) = VersionLog.Load(L);
}
