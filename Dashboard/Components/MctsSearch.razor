@using PuertoRico.Engine.Game
@using PuertoRico.Engine.Strategies

@* The MCTS search behind one decision: every legal action with its visit count and mean reward for the acting seat. *@
<div class="mcts">
    <div class="muted">MCTS 搜尋：@Search.Simulations 次模擬；模擬次數最多的動作被選中。「佔比」= 該動作的模擬次數 ÷ 總模擬次數。「平均報酬」= 該動作之後的模擬結果對本座位的平均值（0～1，0.6×獲勝＋0.4×名次分）。</div>
    <div class="tablewrap">
        <table class="data fit">
            <thead><tr><th class="left">動作</th><th>模擬次數</th><th class="left">佔比</th><th>平均報酬</th><th class="left">主要變化（之後最常被搜尋的幾步）</th></tr></thead>
            <tbody>
            @foreach (var i in order)
            {
                var e = Search.Actions[i];
                <tr class="@(e.Action == Chosen ? "chosen" : "")">
                    <td class="left">@(e.Action == Chosen ? "▶ " : "")@Actions[i]</td>
                    <td>@e.Visits</td>
                    <td class="left"><span class="bar" style="width:@((e.Visits * 100.0 / Math.Max(1, Search.Simulations)).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))px"></span> @((e.Visits / (double)Math.Max(1, Search.Simulations)).ToString("P0"))</td>
                    <td>@(e.Visits > 0 ? e.MeanReward.ToString("0.000") : "—")</td>
                    <td class="left line">@(Lines != null && Lines[i] != "" ? Lines[i] : "—")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public SearchSummary Search { get; set; } = default!;
    [Parameter, EditorRequired] public IReadOnlyList<string> Actions { get; set; } = default!;
    /// <summary>Principal variation text per action (same order as <see cref="Actions"/>); optional.</summary>
    [Parameter] public IReadOnlyList<string>? Lines { get; set; }
    [Parameter] public GameAction Chosen { get; set; }

    private IEnumerable<int> order => Enumerable.Range(0, Search.Actions.Count).OrderByDescending(i => Search.Actions[i].Visits);
}
