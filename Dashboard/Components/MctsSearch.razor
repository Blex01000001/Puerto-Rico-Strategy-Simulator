@using PuertoRico.Engine.Game
@using PuertoRico.Engine.Strategies

@* The MCTS search behind one decision: every legal action with its visit count and mean reward for the acting seat. *@
<div class="mcts">
    <div class="mctstable">
        <div class="mctshead">
            <strong>MCTS 搜尋</strong>
            <span class="chip">@Search.Simulations 次模擬</span>
            @if (Search.RolloutStrategy != "")
            {
                <span class="chip" title="樹搜尋之後，所有座位（含對手與自己）都用這個策略往下打到停止點；它決定模擬裡對手怎麼出牌。">模擬對手：@Palette.DisplayName(Search.RolloutStrategy)</span>
                <span class="chip" title="往下打這麼多回合後，以當時的分數排名當作結果；打到終局最準但最慢。">@(Search.RolloutRounds == 0 ? "打到終局" : $"往下打 {Search.RolloutRounds} 回合")</span>
            }
            @if (Search.Exploration > 0) { <span class="chip" title="UCT 的探索係數：越大越願意試冷門動作。">探索係數 @Search.Exploration.ToString("0.##")</span> }
        </div>
        <div class="mctslegend">
            <span class="sw sw-chosen"></span>被選中（模擬次數最多）
            <span class="sw sw-clear"></span>被選中，且平均報酬明顯勝過第 2、3 名（差距大於雜訊）
        </div>
        <div class="tablewrap">
            <table class="data fit">
                <thead><tr>
                    <th class="left act">動作</th>
                    <th class="mid">模擬次數</th>
                    <th class="left">佔比</th>
                    <th>勝率</th>
                    <th>平均報酬</th>
                    <th>UCT</th>
                </tr></thead>
                <tbody>
                @foreach (var i in order)
                {
                    var e = Search.Actions[i];
                    double share = e.Visits / (double)Math.Max(1, Search.Simulations);
                    <tr class="@(e.Action == Chosen ? (clear ? "chosen clear" : "chosen") : "")">
                        <td class="left act">@if (e.Action == Chosen) { <span class="mark">▶</span> }@Actions[i]</td>
                        <td class="mid">@e.Visits</td>
                        <td class="share"><span class="track"><span class="bar" style="width:@((share / maxShare * 100).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></span></span><span class="pct">@share.ToString("P0")</span></td>
                        <td>@(e.Visits > 0 ? e.WinRate.ToString("P0") : "—")</td>
                        <td>@(e.Visits > 0 ? e.MeanReward.ToString("0.000") : "—")</td>
                        <td>@(Search.Uct(e) is { } u ? u.ToString("0.000") : "—")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
    <ul class="mctshelp">
        <li><strong>模擬次數／佔比</strong>：搜尋試了這個動作幾次。越大越被看好，最大的被選中。</li>
        <li><strong>勝率</strong>：這些模擬中本座位獲勝的比例。只供參考，搜尋不用它。</li>
        <li><strong>平均報酬</strong>：0.6×獲勝＋0.4×名次分（0～1）。<em>越大＝選它之後的結果越好</em>，搜尋比的就是它。</li>
        <li><strong>綠色</strong>：被選中的動作，平均報酬比第 2、3 名都高出「雜訊」（兩者標準誤差合併後的 @SearchSummary.NoiseZ.ToString("0") 倍）以上，代表領先不是運氣；藍色則表示領先幅度還在雜訊之內。</li>
        <li><strong>UCT</strong>：平均報酬＋探索加成。<em>越大＝下一次模擬越會選它</em>（結果好，或試得還不夠多）。</li>
    </ul>
</div>

@code {
    [Parameter, EditorRequired] public SearchSummary Search { get; set; } = default!;
    [Parameter, EditorRequired] public IReadOnlyList<string> Actions { get; set; } = default!;
    [Parameter] public GameAction Chosen { get; set; }

    /// <summary>Largest visit share: the bars are scaled to it, so the longest bar is always full.</summary>
    private double maxShare => Math.Max(1e-9, Search.Actions.Max(a => a.Visits) / (double)Math.Max(1, Search.Simulations));

    /// <summary>True when the chosen action's mean reward beats the 2nd and 3rd most visited actions by more than the noise.</summary>
    private bool clear
    {
        get
        {
            var ranked = order.Select(i => Search.Actions[i]).ToList();
            var first = ranked.FirstOrDefault(e => e.Action == Chosen);
            if (first == null) return false;
            var rivals = ranked.Where(e => e.Action != Chosen).Take(2).ToList();
            return rivals.Count > 0 && rivals.All(r => SearchSummary.ClearlyAhead(first, r));
        }
    }

    private IEnumerable<int> order => Enumerable.Range(0, Search.Actions.Count).OrderByDescending(i => Search.Actions[i].Visits);
}
