@using PuertoRico.Engine.Game
@using PuertoRico.Engine.Strategies

@* The MCTS search behind one decision: every legal action with its visit count and mean reward for the acting seat. *@
<div class="mcts">
    <div class="mctstable">
        <div class="mctshead">
            <strong>MCTS 搜尋</strong>
            <span class="chip">@Search.Simulations 次模擬</span>
            @if (Search.RolloutStrategy != "")
            {
                <span class="chip" title="樹搜尋之後，所有座位（含對手與自己）都用這個策略往下打到停止點；它決定模擬裡對手怎麼出牌。">模擬對手：@Palette.DisplayName(Search.RolloutStrategy)</span>
                <span class="chip" title="往下打這麼多回合後，以當時的分數排名當作結果；打到終局最準但最慢。">@(Search.RolloutRounds == 0 ? "打到終局" : $"往下打 {Search.RolloutRounds} 回合")</span>
            }
            @if (Search.Exploration > 0) { <span class="chip" title="UCT 的探索係數：越大越願意試冷門動作。">探索係數 @Search.Exploration.ToString("0.##")</span> }
        </div>
        <div class="mctslegend">
            被選中的動作（與模擬次數第 2 名比平均報酬）：
            <span class="sw sw-green"></span>明顯領先
            <span class="sw sw-yellow"></span>稍微領先
            <span class="sw sw-red"></span>模擬次數／報酬偏低
        </div>
        <div class="tablewrap">
            <table class="data">
                <thead><tr>
                    <th class="left act">動作</th>
                    <th class="mid">N</th>
                    <th class="left">佔比</th>
                    <th>勝率</th>
                    <th class="mid">Q</th>
                    <th class="mid">SE</th>
                    <th class="mid">ΔQ</th>
                    <th class="mid">Noise</th>
                    <th class="uct">UCT<span class="next"></span></th>
                </tr></thead>
                <tbody>
                @foreach (var i in order)
                {
                    var e = Search.Actions[i];
                    double share = e.Visits / (double)Math.Max(1, Search.Simulations);
                    <tr class="@(e.Action == Chosen ? "chosen " + signalClass : "")">
                        <td class="left act">@if (e.Action == Chosen) { <span class="mark">▶</span> }@Actions[i]</td>
                        <td class="mid">@e.Visits</td>
                        <td class="share"><span class="track"><span class="bar" style="width:@((share / maxShare * 100).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></span></span><span class="pct">@share.ToString("P0")</span></td>
                        <td>@(e.Visits > 0 ? e.WinRate.ToString("P0") : "—")</td>
                        <td class="mid">@(e.Visits > 0 ? e.MeanReward.ToString("0.000") : "—")</td>
                        <td class="mid">@(e.Visits > 1 ? e.StdError.ToString("0.000") : "—")</td>
                        <td class="mid @DeltaClass(e)" title="被選中的動作 Q − 這一列 Q">@(DeltaText(e))</td>
                        <td class="mid" title="被選中的動作與這一列比較時，Q 差距要超過的門檻">@(NoiseText(e))</td>
                        <td class="uct">@(Search.Uct(e) is { } u ? u.ToString("0.000") : "—")<span class="next" title="@NextTitle">@(i == nextIndex ? "🎯" : "")</span></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <ul class="mctshelp">
            <li><strong>模擬次數 N（Visits）</strong>：這個節點被模擬經過的次數，N 越大結論越可靠；迭代結束後，選根節點下 N 最大的子節點作為最終動作</li>
            <li><strong>單次報酬 r</strong>：0.6×獲勝(1、0) + 0.4×名次分(1、0.67、0.33、0)</li>
            <li><strong>平均報酬 Q（Average Reward）</strong>：所有經過此節點的 r 的平均，介於 0~1；對「該節點的決策玩家」而言，Q 越大代表結果平均越好</li>
            <li><strong>標準誤差 SE（Standard Error）</strong>：平均報酬 Q 的不確定程度，SE = σ ÷ √N；SE 越小，代表 Q 越穩定、越可靠（N 越大，SE 越小）</li>
            <li><strong>差距 ΔQ</strong>：被選中的動作 Q 減去該列 Q（被選中的那一列不顯示）；ΔQ 超過 Noise 顯示綠色（被選中的明顯較好），低於 −Noise 顯示紅色（該列明顯較好），其餘不上色</li>
            <li><strong>雜訊 Noise</strong>：被選中的動作與該列動作比較時，兩者 Q 的差距至少要超過的門檻，Noise = @SearchSummary.NoiseZ.ToString("0.#") × √(SE選中² + SE該列²)；Q 差距沒超過 Noise，就可能只是運氣（被選中的那一列不顯示）</li>
            <li><strong>UCT</strong>：Q + C×√(ln N父 ÷ N子)；選擇時挑 UCT 最高的子節點往下走，探索加成讓少被試的動作有機會被選到</li>
            <li><strong>燈號</strong>（被選中的列 vs 第 2 名，雜訊＝合併標準誤差的 @SearchSummary.NoiseZ.ToString("0.#") 倍）：<span class="lg">綠</span>:明顯非運氣；<span class="ly">黃</span>:稍微領先，存在雜訊或樣本過少；<span class="lr">紅</span>:模擬次數不足或報酬偏低。</li>
        </ul>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public SearchSummary Search { get; set; } = default!;
    [Parameter, EditorRequired] public IReadOnlyList<string> Actions { get; set; } = default!;
    [Parameter] public GameAction Chosen { get; set; }

    /// <summary>Largest visit share: the bars are scaled to it, so the longest bar is always full.</summary>
    private double maxShare => Math.Max(1e-9, Search.Actions.Max(a => a.Visits) / (double)Math.Max(1, Search.Simulations));

    /// <summary>Traffic light of the chosen action against the 2nd most visited action.</summary>
    private string signalClass
    {
        get
        {
            var ranked = order.Select(i => Search.Actions[i]).ToList();
            var first = ranked.FirstOrDefault(e => e.Action == Chosen);
            if (first == null) return "";
            var rivals = ranked.Where(e => e.Action != Chosen).Take(1).ToList();
            return SearchSummary.Assess(first, rivals) switch
            {
                SearchSummary.PickSignal.Green => "green",
                SearchSummary.PickSignal.Red => "red",
                _ => "yellow",
            };
        }
    }

    /// <summary>Index of the action with the largest UCT: the one the next simulation would pick (-1 when nothing was visited).</summary>
    private int nextIndex
    {
        get
        {
            int best = -1;
            double bestUct = double.NegativeInfinity;
            for (int i = 0; i < Search.Actions.Count; i++)
                if (Search.Uct(Search.Actions[i]) is { } u && u > bestUct) { bestUct = u; best = i; }
            return best;
        }
    }

    private SearchSummary.Entry? chosenEntry => Search.Actions.FirstOrDefault(a => a.Action == Chosen);

    /// <summary>ΔQ column: Q of the chosen action minus Q of this row (blank for the chosen row and for unvisited rows).</summary>
    private string DeltaText(SearchSummary.Entry e)
    {
        var c = chosenEntry;
        if (c == null || e.Action == Chosen || c.Visits < 1 || e.Visits < 1) return "—";
        double d = c.MeanReward - e.MeanReward;
        return (d >= 0 ? "+" : "−") + Math.Abs(d).ToString("0.000");
    }

    /// <summary>Colour class of ΔQ: green when it exceeds Noise, red when it is below −Noise (needs 2+ visits on both sides).</summary>
    private string DeltaClass(SearchSummary.Entry e)
    {
        var c = chosenEntry;
        if (c == null || e.Action == Chosen) return "";
        if (SearchSummary.ClearlyAhead(c, e)) return "dgood";
        if (SearchSummary.ClearlyAhead(e, c)) return "dbad";
        return "";
    }

    /// <summary>Noise column: 1.5 × combined SE against the chosen action (blank for the chosen row and for actions with too few visits).</summary>
    private string NoiseText(SearchSummary.Entry e)
    {
        var chosen = Search.Actions.FirstOrDefault(a => a.Action == Chosen);
        if (chosen == null || e.Action == Chosen || chosen.Visits < 2 || e.Visits < 2) return "—";
        return SearchSummary.Noise(chosen, e).ToString("0.000");
    }

    private string NextTitle => Search.Actions.Any(a => a.Visits == 0)
        ? "下一次模擬會選它（UCT 最大）；另有尚未模擬的動作，搜尋會先試它們"
        : "下一次模擬會選它（UCT 最大）";

    private IEnumerable<int> order => Enumerable.Range(0, Search.Actions.Count).OrderByDescending(i => Search.Actions[i].Visits);
}
