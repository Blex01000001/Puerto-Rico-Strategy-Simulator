@using PuertoRico.Engine.Game

@* Read-only picture of a game state, sized to fit one window. The shared supply (roles, goods, ships, trading house) is the
   middle column, exactly four role cards wide; the player cards sit in the two side columns in turn order, clockwise
   from the bottom left: seat 1 bottom left, seat 2 top left, seat 3 top right, seat 4 bottom right. *@
<div class="board seats@(S.PlayerCount)">
    <div class="area-mid boardbox supply">
        <div class="boardhead midhead">
            <div>@((MarkupString)L.T("bv.round", S.Round, PhaseName(S.Phase)))</div>
            <div>
                @if (!S.IsOver) { <span>@((MarkupString)L.T("bv.turn", S.Governor + 1, S.Actor + 1))</span> }
                else { <strong>@L.T("bv.over")</strong> }
            </div>
        </div>

        <div class="groupbox">
            <h4>@L.T("bv.roles")</h4>
            <div class="rolerow">
                @for (int r = 0; r < S.RoleCount; r++)
                {
                    <div class="rolecard @(S.RoleOwner[r] >= 0 ? "taken" : "")">
                        <div class="rname">@RoleName(r)</div>
                        <div class="rinfo">
                            @if (S.RoleOwner[r] >= 0) { <span class="pill">@L.T("sim.seat_n", S.RoleOwner[r] + 1)</span> }
                            else if (S.RoleCoins[r] > 0) { <span>@L.T("bv.coins_plus", S.RoleCoins[r])</span> }
                            else { <span class="muted">@L.T("bv.available")</span> }
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="groupbox">
            <h4>@L.T("bv.supply")</h4>
            <table class="supplytable">
                <tr><th></th>@for (int g = 0; g < GameConstants.GoodCount; g++) { <td><span class="good" style="background:var(--good-@g)"></span>@GoodName(g)</td> }</tr>
                <tr><th>@L.T("bv.goods")</th>@for (int g = 0; g < GameConstants.GoodCount; g++) { <td><strong>@S.GoodsSupply[g]</strong></td> }</tr>
                <tr><th>@L.T("bv.faceup")</th>@for (int g = 0; g < GameConstants.GoodCount; g++) { <td><strong>@S.FaceUp[g]</strong></td> }</tr>
            </table>
            <div class="cardrow">
                <div class="statcard"><span class="ctitle">@L.T("bv.deck")</span><strong>@S.DeckTotal()</strong></div>
                <div class="statcard"><span class="ctitle">@L.T("bv.quarries")</span><strong>@S.QuarrySupply</strong></div>
                <div class="statcard"><span class="ctitle">@L.T("bv.vp")</span><strong>@S.VpSupply</strong></div>
                <div class="statcard"><span class="ctitle">@L.T("bv.bank")</span><strong>@S.BankColonists</strong></div>
                <div class="statcard"><span class="ctitle">@L.T("bv.colonist_ship")</span><strong>@S.ShipColonists</strong></div>
            </div>
        </div>

        <div class="groupbox">
            <h4>@L.T("bv.ships")</h4>
            @for (int i = 0; i < GameConstants.ShipCount; i++)
            {
                <div class="shiprow">
                    @if (S.ShipLoad[i] > 0)
                    {
                        for (int k = 0; k < S.ShipLoad[i]; k++) { <span class="good" style="background:var(--good-@S.ShipGood[i])" title="@GoodName(S.ShipGood[i])"></span> }
                        for (int k = S.ShipLoad[i]; k < S.ShipCap[i]; k++) { <span class="good empty"></span> }
                        <span class="muted">　@GoodName(S.ShipGood[i]) @S.ShipLoad[i]/@S.ShipCap[i]</span>
                    }
                    else
                    {
                        for (int k = 0; k < S.ShipCap[i]; k++) { <span class="good empty"></span> }
                        <span class="muted">　@L.T("bv.empty0", S.ShipCap[i])</span>
                    }
                </div>
            }
            <h4>@L.T("bv.trade", S.TradeCount, GameConstants.TradeSlots)</h4>
            <div class="shiprow">
                @for (int i = 0; i < GameConstants.TradeSlots; i++)
                {
                    if (i < S.TradeCount) { <span class="good" style="background:var(--good-@S.TradeHouse[i])" title="@GoodName(S.TradeHouse[i])"></span> }
                    else { <span class="good empty"></span> }
                }
                <span class="muted">　@(S.TradeCount > 0 ? string.Join(L.T("common.list"), Enumerable.Range(0, S.TradeCount).Select(i => GoodName(S.TradeHouse[i]))) : L.T("bv.empty"))</span>
            </div>
        </div>
    </div>

        @for (int p = 0; p < S.PlayerCount; p++)
        {
            int seat = p;
            <div class="boardplayer area-p@(seat + 1) @(!S.IsOver && S.Actor == seat ? "acting" : "")">
                <div class="playerhead">
                    <div class="pname">
                        <div class="pline" title="@SeatName(seat)"><strong>@L.T("sim.seat_n", seat + 1)</strong> · @SeatName(seat)</div>
                        <div class="ptags">
                            @if (S.Governor == seat) { <span class="pill">@L.T("bv.governor")</span> }
                            @for (int r = 0; r < S.RoleCount; r++) { if (S.RoleOwner[r] == seat) { <span class="pill role">@RoleName(r)</span> } }
                        </div>
                    </div>
                    <div class="cardrow">
                        <div class="statcard"><span class="ctitle">@L.T("bv.coins")</span><strong>@S.Coins[seat]</strong></div>
                        <div class="statcard"><span class="ctitle">@L.T("bv.vp_short")</span><strong>@S.VpChips[seat]</strong></div>
                        <div class="statcard"><span class="ctitle">@L.T("bv.colonists")</span><strong>@S.SanJuan[seat]</strong></div>
                    </div>
                </div>

                <div class="brow">
                    <span class="blabel">@L.T("bv.plantations")</span>
                    <div class="tilesrow">
                        @for (int t = 0; t < GameConstants.TileTypes; t++)
                        {
                            int count = S.Tiles[seat * GameConstants.TileTypes + t];
                            int occ = S.TilesOcc[seat * GameConstants.TileTypes + t];
                            for (int k = 0; k < count; k++)
                            {
                                <span class="tile" style="background:@(t == GameConstants.QuarryType ? "var(--good-q)" : $"var(--good-{t})")" title="@(t == GameConstants.QuarryType ? L.T("bv.quarry") : GoodName(t))">@(k < occ ? "●" : "")</span>
                            }
                        }
                        @if (S.TileCount(seat) == 0) { <span class="muted">@L.T("bv.none")</span> }
                    </div>
                </div>

                <div class="brow">
                    <span class="blabel">@L.T("bv.buildings")</span>
                    <div class="bldrow">
                        @for (int b = 0; b < GameConstants.BuildingCount; b++)
                        {
                            if (S.BuildingOwned[seat * GameConstants.BuildingCount + b] == 0) continue;
                            var info = Buildings.All[b];
                            int occ = S.BuildingOcc[seat * GameConstants.BuildingCount + b];
                            <span class="bld @(info.Large ? "large" : "") @(info.IsProduction ? "prod" : "")" title="@L.T("bv.building_title", info.Cost, info.Vp)">
                                @info.Name
                                <span class="dots">@string.Concat(Enumerable.Repeat("●", Math.Min(occ, info.Capacity)))@string.Concat(Enumerable.Repeat("○", Math.Max(0, info.Capacity - occ)))</span>
                            </span>
                        }
                        @if (!HasBuildings(seat)) { <span class="muted">@L.T("bv.none")</span> }
                    </div>
                </div>

                <div class="brow">
                    <span class="blabel">@L.T("bv.goods")</span>
                    <div class="shiprow">
                        @for (int g = 0; g < GameConstants.GoodCount; g++)
                        {
                            int n = S.Goods[seat * GameConstants.GoodCount + g];
                            for (int k = 0; k < n; k++) { <span class="good" style="background:var(--good-@g)" title="@GoodName(g)"></span> }
                        }
                        @if (S.GoodTotal(seat) == 0) { <span class="muted">@L.T("bv.none")</span> }
                    </div>
                </div>
            </div>
        }
</div>

@code {
    [Parameter, EditorRequired] public GameState S { get; set; } = default!;
    /// <summary>Display name of the strategy at a table seat.</summary>
    [Parameter] public Func<int, string> SeatNameOf { get; set; } = seat => "";

    private string SeatName(int seat) => SeatNameOf(seat);

    private bool HasBuildings(int seat)
    {
        for (int b = 0; b < GameConstants.BuildingCount; b++) if (S.BuildingOwned[seat * GameConstants.BuildingCount + b] != 0) return true;
        return false;
    }

    private string GoodName(int g) => Dashboard.Services.ActionText.GoodName(L, g);
    private string RoleName(int r) => Dashboard.Services.ActionText.RoleName(L, r);

    private string PhaseName(Phase p) => p switch
    {
        Phase.Mayor or Phase.CraftsmanBonus or Phase.GameOver => L.T("bv.phase." + p),
        Phase.ChooseRole or Phase.Settler or Phase.Builder or Phase.Trader or Phase.Captain or Phase.CaptainStorage => L.T("phase." + p),
        _ => p.ToString(),
    };
}
