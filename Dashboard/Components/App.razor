<!DOCTYPE html>
<html lang="@(Chinese ? "zh-Hant" : "en")">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <title>@Text.T("app.title")</title>
    <base href="/" />
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <link rel="stylesheet" href="app.css" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" Lang="@Lang" />
    <script src="_framework/blazor.web.js"></script>
    <script>
        // Replay page: left / right arrow = previous / next step (not while typing in a field or dragging the slider).
        document.addEventListener('keydown', function (e) {
            if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
            if (e.ctrlKey || e.altKey || e.metaKey || e.shiftKey) return;
            var t = e.target, tag = t && t.tagName;
            if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT' || (t && t.isContentEditable)) return;
            var button = document.getElementById(e.key === 'ArrowLeft' ? 'replay-prev' : 'replay-next');
            if (!button || button.disabled) return;
            e.preventDefault();
            button.click();
        });
        // Results page: copy the summary text (works on localhost, which counts as a secure context).
        window.prCopy = function (text) { return navigator.clipboard.writeText(text); };
        // ML UI button (MlUiNav): a tab opened during the click (later ones are blocked as pop-ups), sent to the ML UI once it answers.
        window.prMlTab = {
            open: function (message) {
                var w = window.open('', '_blank');
                if (w) { w.document.title = 'ML UI'; w.document.body.style.cssText = 'font-family:system-ui,sans-serif;background:#111418;color:#eef1f5;padding:2rem'; w.document.body.textContent = message || 'ML UI…'; }
                window.prMlTabRef = w;
            },
            go: function (url) { var w = window.prMlTabRef; if (w && !w.closed) w.location = url; else window.open(url, '_blank'); window.prMlTabRef = null; },
            close: function () { var w = window.prMlTabRef; if (w && !w.closed) w.close(); window.prMlTabRef = null; }
        };
    </script>
</body>

</html>

@code {
    [CascadingParameter] private HttpContext? Http { get; set; }

    private string Lang => Loc.Choose(Http?.Request.Cookies[Loc.Cookie]);
    private bool Chinese => Lang == "zh-TW";
    private Loc Text { get { var l = new Loc(); l.Use(Lang); return l; } }
}
