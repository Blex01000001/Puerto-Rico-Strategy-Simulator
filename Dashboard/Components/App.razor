<!DOCTYPE html>
<html lang="zh-Hant">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <title>波多黎各策略模擬器</title>
    <base href="/" />
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <link rel="stylesheet" href="app.css" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
    <script>
        // Replay page: left / right arrow = previous / next step (not while typing in a field or dragging the slider).
        document.addEventListener('keydown', function (e) {
            if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
            if (e.ctrlKey || e.altKey || e.metaKey || e.shiftKey) return;
            var t = e.target, tag = t && t.tagName;
            if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT' || (t && t.isContentEditable)) return;
            var button = document.getElementById(e.key === 'ArrowLeft' ? 'replay-prev' : 'replay-next');
            if (!button || button.disabled) return;
            e.preventDefault();
            button.click();
        });
        // ML UI button (MlUiNav): a tab opened during the click (later ones are blocked as pop-ups), sent to the ML UI once it answers.
        window.prMlTab = {
            open: function () {
                var w = window.open('', '_blank');
                if (w) { w.document.title = 'ML UI'; w.document.body.style.cssText = 'font-family:system-ui,sans-serif;background:#111418;color:#eef1f5;padding:2rem'; w.document.body.textContent = 'ML UI 啟動中…（約 5～20 秒）'; }
                window.prMlTabRef = w;
            },
            go: function (url) { var w = window.prMlTabRef; if (w && !w.closed) w.location = url; else window.open(url, '_blank'); window.prMlTabRef = null; },
            close: function () { var w = window.prMlTabRef; if (w && !w.closed) w.close(); window.prMlTabRef = null; }
        };
    </script>
</body>

</html>
